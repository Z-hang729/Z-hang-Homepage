---
import {url,formatDate} from '../lib/site';
import {formatFileSize,stableFilePath,originalDownloadURL,fileGroup,fileSearchText} from '../lib/files.mjs';
import {fileFolder,fileCategories,plainDescription,FILE_GROUP_LABELS,FILE_CATEGORY_LABELS} from '../file-preview/library-model.mjs';
interface Props {file:any;related?:{title:string;href:string;search?:string}[];}
const {file,related=[]}=Astro.props;
const group=fileGroup(file),symbols:Record<string,string>={pdf:'PDF',images:'IMG',notes:'MD',code:'CODE',data:'DATA',notebooks:'NB',archives:'ZIP',media:'AV',documents:'DOC',other:'FILE'};
const page=url(stableFilePath(file.id)),description=plainDescription(file.description),search=fileSearchText(file,related.map(item=>`${item.title} ${item.search||''}`).join(' '));
---
<article class="file-card" data-file-card data-file-id={file.id} data-file-name={search} data-file-group={group} data-file-category={file.category} data-file-categories={fileCategories(file).join(' ')} data-file-tags={JSON.stringify(file.tags||[])} data-file-folder={fileFolder(file)} data-file-updated={file.updatedAt} data-file-added={file.uploadedAt} data-file-size={file.size} data-file-display-name={file.displayName}>
  <span class="file-badge" aria-hidden="true">{symbols[group]||'FILE'}</span>
  <div class="file-card-content">
    <div class="file-card-kicker"><span>{FILE_GROUP_LABELS[group]||'File'}</span><span>{FILE_CATEGORY_LABELS[file.category]||'General'}</span></div>
    <h3><a href={page}>{file.displayName}</a></h3>
    <p class="file-card-path" title={file.relativePath}>{file.relativePath}</p>
    {description&&<p class="file-card-description">{description}</p>}
    <p class="file-card-meta"><span>{file.extension?.toUpperCase()||'FILE'} · {formatFileSize(file.size)}</span><span>Updated <time datetime={file.updatedAt}>{formatDate(file.updatedAt)}</time></span></p>
    {related.length>0&&<div class="file-card-related">{related.slice(0,2).map(item=><a href={url(item.href)}>{item.title}</a>)}{related.length>2&&<span>+{related.length-2} related</span>}</div>}
    {file.tags?.length>0&&<div class="file-card-tags" aria-label="File tags">{file.tags.slice(0,4).map((tag:string)=><span>{tag}</span>)}{file.tags.length>4&&<span>+{file.tags.length-4}</span>}</div>}
    <div class="file-actions" data-pagefind-ignore><a href={page} aria-label={`Preview ${file.displayName}`}>Preview ↗</a><a href={url(originalDownloadURL(file))} download={file.originalName} aria-label={`Download original ${file.originalName}`}>Download ↓</a><button type="button" data-file-copy={page} aria-label={`Copy stable link to ${file.displayName}`}>Copy link</button></div>
  </div>
</article>
<style>
 .file-card{display:flex;gap:1rem;align-items:flex-start;border:1px solid var(--line);border-radius:12px;padding:1.15rem;background:var(--surface);min-width:0;transition:border-color .18s}.file-card:hover,.file-card:focus-within{border-color:var(--accent)}.file-badge{font:600 .65rem var(--font-mono);color:var(--accent);border-radius:7px;background:var(--accent-soft);min-width:3rem;padding:.8rem .3rem;text-align:center;flex-shrink:0}.file-card-content{min-width:0;flex:1}.file-card-kicker{display:flex;gap:.7rem;flex-wrap:wrap;font:10px var(--font-mono);color:var(--muted);margin-bottom:.55rem}.file-card-kicker span+span{color:var(--accent)}.file-card h3{font:600 1rem/1.45 var(--font-sans);margin:0 0 .3rem;overflow-wrap:anywhere}.file-card p{margin:.3rem 0;overflow-wrap:anywhere}.file-card-path{font-size:.72rem;color:var(--muted);white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.file-card-description{font-size:.86rem;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.file-card .file-card-meta{display:flex;flex-wrap:wrap;gap:.3rem .8rem;color:var(--muted);font-size:.72rem;margin-top:.65rem}.file-card-related{display:flex;flex-wrap:wrap;gap:.3rem .6rem;font-size:.72rem;margin-top:.5rem;color:var(--accent)}.file-card-related a{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-card-tags{display:flex;flex-wrap:wrap;gap:.25rem;font-size:.65rem;margin-top:.55rem;color:var(--muted)}.file-card-tags span{border:1px solid var(--line);border-radius:4px;padding:0 .35rem}.file-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:.85rem;color:var(--accent);font-size:.78rem}.file-actions button{border:0;background:none;padding:0;font:inherit;color:inherit;cursor:pointer}.file-actions a:hover,.file-actions button:hover{text-decoration:underline}@media(prefers-reduced-motion:reduce){.file-card{transition:none}}
</style>
