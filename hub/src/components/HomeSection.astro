---
import ContentCard from './ContentCard.astro';
import Magnetosphere from './Magnetosphere.astro';
import Icon from './Icon.astro';
import { profile, url, formatDate } from '../lib/site';
import type { HomepageSection } from '../lib/site';
interface Props { section: HomepageSection; focusSection?: HomepageSection; research: any[]; notes: any[]; logs: any[]; projects: any[]; }
const { section, focusSection, research, notes, logs, projects } = Astro.props;
const id = section.id;
---
{id === 'hero' && <section class="hero" data-owner-section={id} id={id}>
  <div class="hero-topline"><p class="eyebrow" style="margin:0">{section.title || 'THE ACADEMIC GARDEN'} <span style="color:var(--muted)">/ 01</span></p></div>
  <div class="hero-grid"><div>
    <h1><span data-owner-field="heroFirstLine">{profile.heroFirstLine}</span><br/><em data-owner-field="heroSecondLine">{profile.heroSecondLine}</em></h1>
    <p class="hero-subtitle"><strong><span data-owner-field="displayName">{profile.displayName}</span> · <span data-owner-field="university">{profile.university}</span></strong><br/><span data-owner-field="role">{profile.role}</span><br/><span data-owner-field="degree">{profile.degree}</span> × <span data-owner-field="secondDegreeShort">{profile.secondDegreeShort}</span></p>
    <div class="hero-actions"><a class="button" href={url('/research/')}>Explore research <Icon name="arrow" size={16}/></a><a class="button-secondary" href={url('/notes/')}>Open the notebook <Icon name="book" size={16}/></a></div>
  </div><Magnetosphere/></div>
  {focusSection && <div class="currently-bar" data-owner-section="current-focus" id="current-focus"><p class="eyebrow">{focusSection.title || 'CURRENTLY'}</p><div class="currently-items" data-owner-field="currently">{profile.currently.map((item: any) => <div class="currently-item"><span>{item.label}</span><strong>{item.text}</strong></div>)}</div></div>}
</section>}
{id === 'current-focus' && <section class="currently-bar standalone-focus" data-owner-section={id} id={id}><p class="eyebrow">{section.title || 'CURRENTLY'}</p><div class="currently-items" data-owner-field="currently">{profile.currently.map((item: any) => <div class="currently-item"><span>{item.label}</span><strong>{item.text}</strong></div>)}</div></section>}
{id === 'about' && <section class="about-strip" data-owner-section={id} id={id}><div><p class="eyebrow">A LITTLE CONTEXT</p><h2>{section.title || 'Curiosity, connected.'}</h2><a class="text-link" href={url('/about/')}>More about me <Icon name="arrow" size={15}/></a></div><div><p class="bio" data-owner-field="bio">{profile.bio}</p><div class="interests" data-owner-field="researchInterests">{profile.researchInterests.map((interest: string) => <span class="interest">{interest}</span>)}</div></div></section>}
{id === 'research' && <section class="section" data-owner-section={id} id={id}><div class="section-heading"><div><h2>{section.title || 'Selected research'}</h2></div><a class="text-link" href={url('/research/')}>All research <Icon name="arrow" size={16}/></a></div><div class="card-grid">{research.map(entry => <ContentCard entry={entry}/>)}</div></section>}
{id === 'research-updates' && <div data-owner-section={id} id={id}><div class="section-heading"><div><h2>{section.title || 'Research updates'}</h2></div><a class="text-link" href={url('/research/')}>View all <Icon name="arrow" size={15}/></a></div>{logs.map(log => <a class="update-row" href={url(`/research/${log.data.project}/#research-log`)}><time datetime={new Date(log.data.date).toISOString()}>{formatDate(log.data.date)}</time><div><h3>{log.data.title}</h3><p>{log.data.demo && <span class="demo-inline">DEMO</span>}{log.data.project.replace(/-/g, ' ')}</p></div></a>)}{!logs.length && <p class="muted">Research logs will appear here as they grow.</p>}</div>}
{id === 'notes' && <div data-owner-section={id} id={id}><div class="section-heading"><div><h2>{section.title || 'Recent notes'}</h2></div><a class="text-link" href={url('/notes/')}>All notes <Icon name="arrow" size={15}/></a></div>{notes.map(note => <a class="update-row" data-owner-entry data-owner-kind="notes" data-owner-slug={note.id} href={url(`/notes/${note.id}/`)}><time datetime={new Date(note.data.updated).toISOString()}>{formatDate(note.data.updated)}</time><div><h3>{note.data.title}</h3><p>{note.data.demo && <span class="demo-inline">DEMO</span>}{note.data.category} · {note.data.semester}</p></div></a>)}</div>}
{id === 'timeline' && <section class="timeline-home" data-owner-section={id} id={id}><div><h2>{section.title || 'Along the way.'}</h2></div><div data-owner-field="timeline">{profile.timeline.map((item: any) => <div class="timeline-entry"><time>{item.date}</time><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></section>}
{id === 'projects' && <section class="section" data-owner-section={id} id={id}><div class="section-heading"><div><h2>{section.title || 'Things I build'}</h2></div><a class="text-link" href={url('/projects/')}>All projects <Icon name="arrow" size={16}/></a></div><div class="two-column">{projects.map(entry => <ContentCard entry={entry} compact/>)}</div></section>}
{id === 'contact' && <section class="contact-section" data-owner-section={id} id={id}><div><p class="eyebrow">CONVERSATIONS START HERE</p><h2>{section.title || 'Let’s connect.'}</h2><p>Questions, ideas, or a shared curiosity about the Sun and space.</p></div><div class="contact-links"><div>{profile.email && <a class="button" data-owner-field="email" href={`mailto:${profile.email}`}><Icon name="mail" size={16}/>Send an email</a>}</div><div>{profile.github && <a class="button-secondary" data-owner-field="github" href={profile.github}><Icon name="github" size={17}/>GitHub <Icon name="diagonal" size={15}/></a>}</div><div data-owner-field="links">{profile.links.map((link: any) => <a class="button-secondary" href={url(link.url)}>{link.title} <Icon name="diagonal" size={15}/></a>)}</div>{!profile.email && !profile.github && !profile.links.length && <p class="muted">Public contact details will be added here.</p>}</div></section>}
<style>
  .standalone-focus{margin-top:0;margin-bottom:42px}
  .contact-links > div:empty{display:none}
  .contact-links > div{display:contents}
</style>
