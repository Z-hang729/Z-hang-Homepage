---
import Magnetosphere from './Magnetosphere.astro';
import { DEFAULT_HERO_ANIMATION, HERO_ANIMATIONS } from '../lib/hero-animation-library.mjs';
import '../styles/hero-animations.css';

interface Props {
  defaultAnimation?: string;
  available?: string[];
}

const { defaultAnimation = DEFAULT_HERO_ANIMATION, available = HERO_ANIMATIONS.map((animation) => animation.id) } = Astro.props;
const configuredAnimations = HERO_ANIMATIONS.filter((animation) => available.includes(animation.id));
const animations = configuredAnimations.length ? configuredAnimations : HERO_ANIMATIONS;
const selected = animations.some((animation) => animation.id === defaultAnimation)
  ? defaultAnimation
  : animations[0]?.id || DEFAULT_HERO_ANIMATION;
---
<div
  class="hero-animation-library"
  data-hero-animation
  data-default-animation={selected}
  data-animation-count={animations.length}
>
  <div class="hero-animation-stage" data-hero-animation-stage>
    <Magnetosphere />
    <div class="hero-animation-dynamic" data-hero-animation-dynamic hidden aria-hidden="true"></div>
  </div>
  <div class="hero-animation-picker" role="group" aria-label="Choose a scientific illustration">
    <p class="hero-animation-picker-label">Explore the illustration</p>
    <div class="hero-animation-options" data-hero-animation-options>
      {animations.map((animation) => (
        <button
          type="button"
          class="hero-animation-option"
          data-animation-id={animation.id}
          aria-pressed={animation.id === selected ? 'true' : 'false'}
          aria-label={`${animation.label}: ${animation.description}`}
          data-label-en={animation.shortLabel}
          data-label-zh={animation.shortLabelZh}
          data-description-en={animation.description}
          data-description-zh={animation.descriptionZh}
          title={animation.description}
        >
          <span class="hero-animation-dot" aria-hidden="true"></span>
          <span data-animation-label>{animation.shortLabel}</span>
        </button>
      ))}
    </div>
    <p class="hero-animation-status" data-hero-animation-status aria-live="polite">
      {animations.find((animation) => animation.id === selected)?.description}
    </p>
    <p class="hero-animation-note">Illustrations are conceptual and not to scale.</p>
  </div>
</div>
<script>
  import '../scripts/hero-animation-client.js';
</script>

