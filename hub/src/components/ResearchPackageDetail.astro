---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeConnections from './KnowledgeConnections.astro';
import {normalizePackage,PACKAGE_FILE_ROLES,packagePath,packageVersionPath,packageIntegrity,packageCitation,packageBibTeX,packageVersions} from '../lib/research-packages.mjs';
import {isPublishedAcademic} from '../lib/figures.mjs';
import {getFiles} from '../lib/file-records';
import {readAcademicRecords} from '../lib/academic-records.mjs';
import {originalDownloadURL,formatFileSize} from '../lib/files.mjs';
import {renderFileDescription} from '../file-preview/description.mjs';
import {url,formatDate} from '../lib/site';
import '../styles/academic-publishing.css';
interface Props {record:any;current?:any;versioned?:boolean;}
const {record,current=record,versioned=false}=Astro.props,files=getFiles(),recordFiles=new Map(files.map(file=>[file.id,file])),entry=normalizePackage(record),base=versioned?packageVersionPath(entry):packagePath(entry),publicURL=new URL(url(packageVersionPath(entry)),Astro.site).href;
const figures=new Map(readAcademicRecords('figures',{publicOnly:true}).map(item=>[item.id,item])),references=new Map(readAcademicRecords('references',{publicOnly:true}).map(item=>[item.id,item]));
const sections=await Promise.all(['description','environment','parameters','steps','notes'].map(async key=>({key,title:{description:'Overview',environment:'Software environment',parameters:'Parameters',steps:'Processing procedure',notes:'Known issues / notes'}[key],html:await renderFileDescription(typeof entry[key]==='string'?entry[key]:'```json\n'+JSON.stringify(entry[key],null,2)+'\n```',import.meta.env.BASE_URL)})));
const labels:Record<string,string>={inputs:'Input data',code:'Source code',configuration:'Configuration',intermediate:'Intermediate results',outputs:'Final outputs',documentation:'Documentation'},versions=packageVersions(current).filter(isPublishedAcademic);
---
<BaseLayout title={`${entry.title} — v${entry.version}`} description={entry.description}>
 <div class="pub-shell" data-owner-package-id={entry.id} data-package-detail>
  <nav class="pub-nav" aria-label="Breadcrumb"><a href={url('/packages/')}>Research packages</a>{versioned&&<a href={url(packagePath(current))}>Current version</a>}</nav>
  <header class="pub-header"><p class="eyebrow">RESEARCH REPRODUCIBILITY / VERSION {entry.version}</p><h1>{entry.title}</h1><p class="pub-meta"><time datetime={entry.date}>{formatDate(entry.date)}</time> · Updated {formatDate(entry.updated)} · {entry.authors.length?entry.authors.join(', '):'Authors unspecified'}</p><p><span class="pub-badge">{entry.status}</span></p>{versioned&&entry.version!==current.version&&<p class="pub-card">This is the immutable v{entry.version} metadata snapshot. File checksums below distinguish its recorded bytes from the current Library metadata.</p>}</header>
  <div class="pub-actions" data-pagefind-ignore><a class="button-secondary" href={url(base+'manifest.json')} download={`package-${entry.version}-manifest.json`}>Download manifest ↓</a><a class="button-secondary" href={url(base+'README.md')} download={`package-${entry.version}-README.md`}>Download README ↓</a><button type="button" class="button-secondary" data-package-copy={publicURL}>Copy version link</button></div><p data-package-copy-status role="status" aria-live="polite"/>
  <p class="pub-card">This package documents an experiment. Commands are displayed as text and are never executed. File integrity is not automatically verified; metadata checksums are distinguished from checks of actual bytes.</p>
  {sections.filter(section=>section.key==='description'&&entry.description).map(section=><section class="pub-section pub-content prose"><h2>{section.title}</h2><div set:html={section.html}/></section>)}
  {PACKAGE_FILE_ROLES.map(role=><section class="pub-section"><h2>{labels[role]}</h2>{entry[role].length?<div class="package-files">{entry[role].map((item:any)=>{const file=recordFiles.get(item.fileId);return <article class="pub-card"><h3>{item.originalName||file?.originalName||item.fileId}</h3><p class="pub-meta"><code>file:{item.fileId}</code>{item.size!=null&&` · ${formatFileSize(item.size)}`}</p><p>{packageIntegrity(item,file)}</p><p class="package-checksum"><strong>Recorded SHA-256:</strong> <code>{item.sha256||'Not verified — no checksum recorded'}</code></p>{file?<div class="pub-actions"><a href={url(`/files/${item.fileId}/`)}>Library preview →</a><a href={url(originalDownloadURL(file))} download={file.originalName}>Download available original ↓</a></div>:<p class="pub-meta">This historical file is unavailable from the current Library. Its recorded ID and checksum remain in this snapshot.</p>}</article>;})}</div>:<p class="pub-meta">No files recorded for this role.</p>}</section>)}
  {entry.codeVersion&&<section class="pub-section"><h2>Source code version</h2><dl class="package-metadata">{entry.codeVersion.repositoryUrl&&<><dt>Repository</dt><dd><a href={entry.codeVersion.repositoryUrl} rel="noopener noreferrer">{entry.codeVersion.repositoryUrl}</a></dd></>}<dt>Commit SHA</dt><dd><code>{entry.codeVersion.commitSha||'Not pinned — no concrete commit SHA recorded'}</code></dd>{entry.codeVersion.tag&&<><dt>Tag</dt><dd>{entry.codeVersion.tag} (a tag alone is not an immutable pin)</dd></>}{entry.codeVersion.filePath&&<><dt>Path</dt><dd><code>{entry.codeVersion.filePath}</code></dd></>}</dl></section>}
  {sections.filter(section=>section.key!=='description').map(section=><section class="pub-section pub-content prose"><h2>{section.title}</h2>{entry[section.key]&&section.html?<div set:html={section.html}/>:<p class="pub-meta">Not recorded.</p>}</section>)}
  <section class="pub-section"><h2>Scientific figures</h2>{entry.figures.length?<ul class="pub-list">{entry.figures.map((id:string)=><li><a href={url(`/figures/${id.replace(/^figure:/,'')}/`)}>{figures.get(id)?.title||id}</a></li>)}</ul>:<p class="pub-meta">No figures attached.</p>}</section>
  <section class="pub-section"><h2>References</h2>{entry.references.length?<ul class="pub-list">{entry.references.map((id:string)=><li><a href={url(`/references/${id.replace(/^reference:/,'')}/`)}>{references.get(id)?.title||id}</a></li>)}</ul>:<p class="pub-meta">No references attached.</p>}</section>
  <section class="pub-section"><h2>Reproducibility status</h2><p><strong>{entry.status}</strong></p>{entry.status==='Verified Reproducible'&&entry.verification?<dl class="package-metadata"><dt>Verified</dt><dd>{formatDate(entry.verification.verifiedAt)}</dd><dt>Method</dt><dd class="verification-text">{entry.verification.method}</dd><dt>Evidence</dt><dd class="verification-text">{entry.verification.evidence}</dd></dl>:<p>This record has no claim of a verified rerun. Its README and file list alone do not establish reproducibility.</p>}</section>
  <section class="pub-section"><h2>Provenance &amp; citation</h2><dl class="package-metadata"><dt>Source</dt><dd>{entry.source}</dd><dt>License</dt><dd>{entry.license}</dd></dl><pre class="pub-code">{packageCitation(entry,publicURL)}</pre><details><summary>BibTeX</summary><pre class="pub-code">{packageBibTeX(entry,publicURL)}</pre></details></section>
  <section class="pub-section"><h2>Stable versions</h2><ul class="pub-list">{versions.map(value=><li><a href={url(packageVersionPath(value))}>v{value.version}</a> · {formatDate(value.updated)} · {value.status}</li>)}</ul></section>
  <KnowledgeConnections id={entry.id}/>
 </div>
</BaseLayout>
<script>document.querySelector<HTMLButtonElement>('[data-package-copy]')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLElement,status=document.querySelector('[data-package-copy-status]')!;try{await navigator.clipboard.writeText(button.dataset.packageCopy!);status.textContent='Version link copied.';}catch{status.textContent='Copy unavailable. Copy the page address from your browser.';}});</script>
<style>.package-files{display:grid;gap:.8rem}.package-files h3{font-size:1rem}.package-checksum{font-size:.8rem;overflow-wrap:anywhere}.package-metadata{display:grid;grid-template-columns:150px minmax(0,1fr);gap:.8rem}.package-metadata dt{color:var(--muted)}.package-metadata dd{margin:0;overflow-wrap:anywhere}.verification-text{white-space:pre-wrap}.pub-content :global(pre){overflow:auto;max-width:100%}@media(max-width:600px){.package-metadata{grid-template-columns:100px minmax(0,1fr);font-size:.85rem}}</style>
