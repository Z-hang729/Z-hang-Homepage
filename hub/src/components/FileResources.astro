---
import FileCard from './FileCard.astro';
import {getFiles} from '../lib/file-records';
import {allEntries} from '../lib/content';
import {url} from '../lib/site';
import {stableFilePath,originalDownloadURL,fileRelations,formatFileSize} from '../lib/files.mjs';
import {folderDownloadMode,fileFolder} from '../file-preview/library-model.mjs';
interface Props {kind?:string;slug?:string;files?:any[];title?:string;library?:boolean;}
const {kind,slug,title='Files',library=false}=Astro.props;
const files=Astro.props.files||getFiles({kind,slug}),visibleFiles=files.filter(file=>!file.isFolderBundle&&!file.isDerivative&&!file.derivativeOf);
const entries=await allEntries(),relations=(file:any)=>['research','notes','projects'].flatMap(kind=>fileRelations(file,kind).map((slug:string)=>{const entry=entries.find(item=>item.collection===kind&&item.id===slug);return {title:entry?.data.title||slug,href:`/${kind}/${slug}/`,search:entry?`${entry.data.description} ${(entry.data as any).course||''} ${(entry.data as any).courseCode||''} ${entry.data.tags.join(' ')}`:''};}));
type Tree={dirs:Map<string,Tree>;files:any[]};
const root:Tree={dirs:new Map(),files:[]};
for(const file of visibleFiles){const parts=file.relativePath.split('/');let node=root;for(const part of parts.slice(0,-1)){if(!node.dirs.has(part))node.dirs.set(part,{dirs:new Map(),files:[]});node=node.dirs.get(part)!;}node.files.push(file);}
const escape=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
function treeHTML(tree:Tree,path=''):string{return '<ul>'+[...tree.dirs].sort(([a],[b])=>a.localeCompare(b)).map(([name,node])=>{const folder=path?`${path}/${name}`:name;return '<li data-file-tree-branch="'+escape(folder)+'"><details open><summary>'+escape(name)+'</summary>'+treeHTML(node,folder)+'</details></li>';}).join('')+tree.files.map(file=>'<li data-file-tree-item="'+escape(file.id)+'"><span aria-hidden="true" class="file-tree-type">'+escape(file.extension.toUpperCase()||'FILE')+'</span><a href="'+escape(url(stableFilePath(file.id)))+'">'+escape(file.displayName)+'</a><small>'+escape(formatFileSize(file.size))+'</small></li>').join('')+'</ul>';}
const folderKey=(file:any)=>file.folderId||fileFolder(file);
const folders=[...new Map(visibleFiles.filter(file=>folderKey(file)).map(file=>[folderKey(file),{id:folderKey(file),name:file.folderName||fileFolder(file)||'Folder',bundle:files.find(bundle=>file.folderId&&bundle.folderId===file.folderId&&bundle.isFolderBundle),files:visibleFiles.filter(item=>folderKey(item)===folderKey(file))}])).values()];
const folderFiles=(files:any[])=>JSON.stringify(files.map(file=>({id:file.id,name:file.relativePath,url:url(originalDownloadURL(file)),page:url(stableFilePath(file.id)),size:file.size,sha256:file.sha256||null})));
---
{(visibleFiles.length>0||library)&&<section class:list={['article-section','file-resources',{'file-resources-library':library}]} id="file-resources">
 <div class="file-results-heading"><h2>{title}</h2>{library&&<p data-library-count aria-live="polite">{visibleFiles.length} {visibleFiles.length===1?'file':'files'}</p>}</div>
 {folders.length>0&&<details class="folder-downloads" data-pagefind-ignore><summary>Folder downloads</summary><div>{folders.map(folder=><div class="folder-download-row"><span><strong>{folder.name}</strong><small>{folder.files.length} files · {formatFileSize(folder.files.reduce((size,file)=>size+file.size,0))}</small></span><div><button type="button" data-folder-download={folderFiles(folder.files)} data-folder-name={folder.name}>{folderDownloadMode(folder.files)==='zip'?'Download folder ZIP ↓':'Download file manifest ↓'}</button>{folder.bundle&&<a href={url(originalDownloadURL(folder.bundle))} download={folder.bundle.originalName}>Uploaded ZIP snapshot ↓</a>}</div></div>)}</div></details>}
 {(root.dirs.size>0||library)&&<details class="file-folders" open={library} data-library-tree><summary>Folder structure</summary><nav class="file-tree" aria-label="File folder structure" set:html={treeHTML(root)}/></details>}
 <div class="file-grid" data-library-cards>{visibleFiles.map(file=><FileCard file={file} related={relations(file)}/>)}</div>
 {library&&<div class="library-empty" data-library-empty hidden><h3>No matching files.</h3><p>Try another search or clear the filters.</p><button type="button" data-library-reset>Clear filters</button></div>}
 <p data-file-status role="status" aria-live="polite" data-pagefind-ignore></p>
</section>}
<script>import '../file-preview/library.js';</script>
<style>
 .file-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr));gap:.85rem}.file-results-heading{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:1rem}.file-results-heading h2{margin:0;font-size:1.45rem}.file-results-heading p{font-size:.78rem;color:var(--muted);margin:0}.file-folders{margin:1rem 0}.folder-downloads{margin:1rem 0;color:var(--muted);font-size:.82rem}.folder-downloads summary{cursor:pointer;color:var(--accent);margin-bottom:.6rem}.folder-download-row{border-bottom:1px solid var(--line);padding:.7rem 0;display:flex;flex-wrap:wrap;gap:.5rem 1rem;justify-content:space-between}.folder-download-row>span{min-width:0;overflow-wrap:anywhere}.folder-download-row small{display:block;font-size:.72rem}.folder-download-row>div{display:flex;flex-wrap:wrap;gap:.5rem .9rem}.folder-downloads a,.folder-downloads button{color:var(--accent)}.folder-downloads button{border:0;background:none;padding:0;font:inherit;cursor:pointer}.file-folders summary{cursor:pointer}.file-tree{border:1px solid var(--line);border-radius:10px;padding:1rem;background:var(--surface);font-size:.86rem;max-width:100%;overflow:auto}.file-tree :global(ul){list-style:none;padding-left:1.1rem;margin:.4rem 0}.file-tree :global(ul ul){border-left:1px solid var(--line)}.file-tree :global(li){padding:.25rem 0;overflow-wrap:anywhere}.file-tree :global(summary){font-weight:600;color:var(--accent)}.file-tree :global(.file-tree-type){font:9px var(--font-mono);color:var(--muted);display:inline-block;min-width:3.2rem;margin-right:.4rem}.file-tree :global(small){color:var(--muted);font-size:.7rem;margin-left:.8rem}.file-resources-library{margin-top:1.4rem!important;padding:0!important}.file-resources-library .file-folders{display:none}.library-empty{padding:3rem 1.5rem;border:1px dashed var(--line);border-radius:12px;text-align:center}.library-empty h3{margin-bottom:.4rem}.library-empty p{color:var(--muted);font-size:.85rem}.library-empty button{border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--accent);padding:.45rem .8rem;font:inherit}:global([data-file-library][data-library-view="list"]) .file-grid{grid-template-columns:1fr}:global([data-file-library][data-library-view="list"]) :global(.file-card-content){display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:1.5rem}:global([data-file-library][data-library-view="list"]) :global(.file-card-kicker),:global([data-file-library][data-library-view="list"]) :global(.file-card-description),:global([data-file-library][data-library-view="list"]) :global(.file-card-tags){display:none}:global([data-file-library][data-library-view="list"]) :global(.file-card h3),:global([data-file-library][data-library-view="list"]) :global(.file-card-path),:global([data-file-library][data-library-view="list"]) :global(.file-card-related){grid-column:1}:global([data-file-library][data-library-view="list"]) :global(.file-card-meta){grid-column:2;grid-row:1/3;justify-content:flex-end;align-content:start;margin:0}:global([data-file-library][data-library-view="list"]) :global(.file-actions){grid-column:2;grid-row:3/5;justify-content:flex-end;margin:.45rem 0 0}:global([data-file-library][data-library-view="folders"]) .file-grid{display:none}:global([data-file-library][data-library-view="folders"]) .file-folders{display:block}.file-resources [data-file-status]{font-size:.8rem;color:var(--muted);overflow-wrap:anywhere}@media(max-width:650px){:global([data-file-library][data-library-view="list"]) :global(.file-card-content){display:block}:global([data-file-library][data-library-view="list"]) :global(.file-card-meta),:global([data-file-library][data-library-view="list"]) :global(.file-actions){justify-content:flex-start;margin-top:.6rem}.file-tree{padding:.7rem}.file-tree :global(ul){padding-left:.65rem}.file-tree :global(small){display:none}.file-results-heading{align-items:flex-start}.file-results-heading h2{font-size:1.2rem}}
</style>
