  sun:'M12 3v1m0 16v1M3 12h1m16 0h1M5.6 5.6l.7.7m11.4 11.4.7.7M5.6 18.4l.7-.7M17.7 6.3l.7-.7',
  moon:'M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z',
  search:'M21 21l-5-5',
  menu:'M4 6h16M4 12h16M4 18h16',
  book:'M12 6v15M12 6C8 3 4 3 2 4v15c3-1 7 0 10 2 3-2 7-3 10-2V4c-3-1-7-1-10 2Z',
  code:'m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  mail:'M3 5h18v14H3ZM3 5l9 7 9-7',
  github:'M9 19c-4 1-4-2-6-2m12 5v-4c0-1 .1-2-1-3 3-.3 6-1.5 6-5a4 4 0 0 0-1-3c.5-1 .4-2-.1-3-2-.1-3 1-4 1a14 14 0 0 0-7 0c-1 0-2-1-4-1-.5 1-.6 2-.1 3a4 4 0 0 0-1 3c0 3.5 3 4.7 6 5-1 1-1 2-1 3v4',
  download:'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  globe:'M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name] || paths.arrow}/>{name === 'search' && <circle cx="10.5" cy="10.5" r="6.5"/>}{name === 'sun' && <circle cx="12" cy="12" r="4"/>}{name === 'globe' && <circle cx="12" cy="12" r="9"/>}</svg>
