---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import {url} from '../lib/site';
interface Props {kind:string;entries:any[];}
const {kind,entries}=Astro.props;
const titles:Record<string,string>={research:"Z-hang’s Research",notes:"Z-hang’s Notes",projects:'Ideas into tools.'};
const descriptions:Record<string,string>={research:'Questions, methods, and experiments. An evolving archive of the work behind the answers.',notes:'A notebook for thinking clearly. Course notes, derivations, and connections across disciplines.',projects:'Scientific computing, small experiments, and useful things at the intersection of physics and code.'};
const unique=(key:string)=>Array.from(new Set(entries.map(e=>e.data[key]).filter(Boolean))).sort();
const tags=Array.from(new Set(entries.flatMap(e=>e.data.tags))).sort();
const years=Array.from(new Set(entries.map(e=>String(e.data.year || (e.data.updated instanceof Date?e.data.updated.getUTCFullYear():e.data.updated)).slice(0,4)))).sort().reverse();
---
<BaseLayout title={titles[kind]} description={descriptions[kind]}><div class="container" data-owner-archive={kind}><header class="page-intro"><p class="eyebrow">{kind==='research'?'THE RESEARCH ARCHIVE':kind==='notes'?'THE OPEN NOTEBOOK':'THE WORKSHOP'}</p><h1>{titles[kind]}</h1><p class="intro-description">{descriptions[kind]}</p>{kind==='research'&&<nav class="archive-tools" aria-label="Research studio tools"><a href={url('/research-studio/')}>Research studio</a><a href={url('/calendar/')}>Calendar</a><a href={url('/research/health/')}>Weekly review</a><a href={url('/datasets/')}>Datasets</a><a href={url('/experiments/')}>Experiments</a><a href={url('/provenance/')}>Provenance</a><a href={url('/export/')}>Exports</a></nav>}<div class="page-intro-bottom"><span class="eyebrow" data-result-count role="status" aria-live="polite">{entries.length} entries</span><div class="view-toggle" role="group" aria-label="Display layout"><button type="button" data-view="grid" aria-pressed="true">Grid</button><button type="button" data-view="timeline" aria-pressed="false">Timeline</button></div></div></header><div class="archive-filter"><label class="filter-search">FIND AN ENTRY<input type="search" data-filter="title" placeholder="Filter by title…" aria-label="Filter by title" aria-controls="archive-results"/></label>{kind==='research'&&<label>STATUS<select data-filter="status" aria-label="Filter by status" aria-controls="archive-results"><option value="">All statuses</option>{['Planning','In Progress','Completed','Paused'].map(status=><option>{status}</option>)}</select></label>}{kind==='notes'&&<><label>SUBJECT<select data-filter="category" aria-label="Filter by subject" aria-controls="archive-results"><option value="">All subjects</option>{['Space Physics','Physics','Mathematics','Computer Science','General Education','Others'].map(category=><option>{category}</option>)}</select></label><label>SEMESTER<select data-filter="semester" aria-label="Filter by semester" aria-controls="archive-results"><option value="">All semesters</option>{unique('semester').map(semester=><option>{semester}</option>)}</select></label><label>COURSE<select data-filter="course" aria-label="Filter by course" aria-controls="archive-results"><option value="">All courses</option>{unique('course').map(course=><option>{course}</option>)}</select></label></>}{kind==='notes'&&<label>YEAR<select data-filter="year" aria-label="Filter by year" aria-controls="archive-results"><option value="">All years</option>{years.map(year=><option>{year}</option>)}</select></label>}<label>TAG<select data-filter="tags" aria-label="Filter by tag" aria-controls="archive-results"><option value="">All tags</option>{tags.map(tag=><option>{tag}</option>)}</select></label></div><div class="archive-body"><div class="card-grid" id="archive-results" data-cards data-layout="grid">{entries.map(entry=><ContentCard entry={entry}/>)}</div><div class="empty-state" data-empty role="status" aria-live="polite" hidden>No entries match these filters.</div></div></div></BaseLayout>
<style>
  .archive-tools{display:flex;flex-wrap:wrap;gap:.65rem 1rem;margin:1.25rem 0;font:11px var(--font-mono)}.archive-tools a{color:var(--accent);text-decoration:none}.archive-tools a:hover{text-decoration:underline}
</style>
