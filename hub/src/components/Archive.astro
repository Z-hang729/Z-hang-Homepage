---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
interface Props {kind:string;entries:any[];}
const {kind,entries}=Astro.props;
const titles:Record<string,string>={research:"Z-hang’s Research",notes:"Z-hang’s Notes",projects:'Ideas into tools.'};
const descriptions:Record<string,string>={research:'Questions, methods, and experiments. An evolving archive of the work behind the answers.',notes:'A notebook for thinking clearly. Course notes, derivations, and connections across disciplines.',projects:'Scientific computing, small experiments, and useful things at the intersection of physics and code.'};
const unique=(key:string)=>Array.from(new Set(entries.map(e=>e.data[key]).filter(Boolean))).sort();
const tags=Array.from(new Set(entries.flatMap(e=>e.data.tags))).sort();
const years=Array.from(new Set(entries.map(e=>String(e.data.year || (e.data.updated instanceof Date?e.data.updated.getUTCFullYear():e.data.updated)).slice(0,4)))).sort().reverse();
---
<BaseLayout title={titles[kind]} description={descriptions[kind]}><div class="container" data-owner-archive={kind}><header class="page-intro"><p class="eyebrow">{kind==='research'?'THE RESEARCH ARCHIVE':kind==='notes'?'THE OPEN NOTEBOOK':'THE WORKSHOP'}</p><h1>{titles[kind]}</h1><p class="intro-description">{descriptions[kind]}</p><div class="page-intro-bottom"><span class="eyebrow" data-result-count>{entries.length} entries</span><div class="view-toggle" role="group" aria-label="Display layout"><button data-view="grid" aria-pressed="true">Grid</button><button data-view="timeline" aria-pressed="false">Timeline</button></div></div></header><div class="demo-banner">Entries labeled <strong>Demo</strong> illustrate this archive’s structure. They do not represent completed research, actual course enrollment, or released software.</div><div class="archive-filter"><label class="filter-search">FIND AN ENTRY<input type="search" data-filter="title" placeholder="Filter by title…" aria-label="Filter by title"/></label>{kind==='research'&&<label>STATUS<select data-filter="status"><option value="">All statuses</option>{['Planning','In Progress','Completed','Paused'].map(status=><option>{status}</option>)}</select></label>}{kind==='notes'&&<><label>SUBJECT<select data-filter="category"><option value="">All subjects</option>{['Space Physics','Physics','Mathematics','Computer Science','General Education','Others'].map(category=><option>{category}</option>)}</select></label><label>SEMESTER<select data-filter="semester"><option value="">All semesters</option>{unique('semester').map(semester=><option>{semester}</option>)}</select></label><label>COURSE<select data-filter="course"><option value="">All courses</option>{unique('course').map(course=><option>{course}</option>)}</select></label></>}{kind==='notes'&&<label>YEAR<select data-filter="year"><option value="">All years</option>{years.map(year=><option>{year}</option>)}</select></label>}<label>TAG<select data-filter="tags"><option value="">All tags</option>{tags.map(tag=><option>{tag}</option>)}</select></label></div><div class="archive-body"><div class="card-grid" data-cards data-layout="grid">{entries.map(entry=><ContentCard entry={entry}/>)}</div><div class="empty-state" data-empty hidden>No entries match these filters.</div></div></div></BaseLayout>
