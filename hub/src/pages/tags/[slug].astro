---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allEntries, dateLabel, entryPath, tagSlug } from '../../lib/content';
import { url } from '../../lib/site';
export async function getStaticPaths() {
  const entries = await allEntries();
  const tags = [...new Map(entries.flatMap((entry) => entry.data.tags).map((tag) => [tagSlug(tag), tag])).entries()];
  return tags.map(([slug, tag]) => ({ params: { slug }, props: { tag, entries: entries.filter((entry) => entry.data.tags.some((value) => tagSlug(value) === slug)) } }));
}
const { tag, entries } = Astro.props;
---
<BaseLayout title={`Tagged: ${tag}`} description={`Research, notes, and projects tagged ${tag}.`}>
  <section class="container tag-page" data-pagefind-body><nav class="breadcrumb" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span><a href={url('/tags/')}>Tags</a><span aria-hidden="true">/</span><span aria-current="page">{tag}</span></nav><header class="section-heading"><span class="eyebrow">CONNECTED IDEAS</span><h1>{tag}</h1><p>{entries.length} {entries.length === 1 ? 'entry' : 'entries'} across the academic archive.</p></header><div class="tag-results">{entries.map((entry) => <a class="tag-result" href={url(entryPath(entry))}><div><span class="eyebrow">{entry.collection} {entry.data.demo && '· DEMO'}</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p><span class="tag-date">Updated {dateLabel(entry.data.updated)}</span></div><span class="tag-arrow" aria-hidden="true">↗</span></a>)}</div></section>
</BaseLayout>
<style>.tag-page{padding-top:3rem;padding-bottom:5rem}.breadcrumb{display:flex;gap:.5rem;font-size:.75rem;color:var(--muted,#667085);margin-bottom:2rem}.section-heading{max-width:720px;margin-bottom:2.5rem}.section-heading h1{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-.04em;margin:.7rem 0}.section-heading p{color:var(--muted,#667085)}.tag-results{max-width:940px}.tag-result{display:flex;justify-content:space-between;gap:1.5rem;padding:1.5rem 0;border-top:1px solid var(--border,#dde5e8);text-decoration:none}.tag-result h2{font-size:1.45rem;margin:.5rem 0}.tag-result p{color:var(--muted,#667085);font-size:.95rem;line-height:1.6}.tag-date{font-size:.75rem;color:var(--muted,#667085)}.tag-arrow{font-size:1.5rem;color:var(--accent,#3388a8)}</style>
