---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const publications=(await getCollection('publications')).sort((a,b)=>+new Date(b.data.date)-+new Date(a.data.date));
---
<BaseLayout title="Publications"><div class="container"><header class="page-intro"><p class="eyebrow">SCHOLARLY OUTPUT</p><h1>Publications &amp; more.</h1><p class="intro-description">Papers, talks, posters, software, and datasets will find a home here.</p></header><section style="padding:25px 0 80px">{publications.length?<div class="card-grid">{publications.map(({data:p})=><article class="content-card"><div class="card-content"><p class="eyebrow">{p.type} · {new Date(p.date).getUTCFullYear()}</p><h2>{p.title}</h2><p>{p.authors.join(', ')}</p>{p.url&&<a class="text-link" href={p.url}>View publication ↗</a>}</div></article>)}</div>:<div class="empty-state"><p class="eyebrow">ROOM TO GROW</p><h2 style="font-family:var(--font-serif);font-size:30px">A chapter yet to be written.</h2><p>No publications have been added.</p></div>}</section></div></BaseLayout>
