---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url, formatDate } from '../../lib/site';
import { researchWorkspace } from '../../lib/research-workspace.mjs';
import { experimentRuns, summarizeRuns } from '../../lib/research-runs.mjs';

const entries = await getCollection('research');
const experiments = entries.flatMap(entry => researchWorkspace(entry).experiments.map(experiment => ({ ...experiment, researchId: `research:${entry.id}`, researchTitle: entry.data.title, researchPath: `/research/${entry.id}/workspace/`, runs: experimentRuns(experiment, { researchId: `research:${entry.id}` }) })));
const runs = experiments.flatMap(experiment => experiment.runs);
const summary = summarizeRuns(runs);
---
<BaseLayout title="Experiment runs" description="Explicit research experiment runs and their recorded provenance.">
  <main class="container catalog-page experiment-catalog" data-experiment-catalog>
    <header class="page-intro catalog-header"><p class="eyebrow">EXPERIMENT RUNS</p><h1>Evidence in motion.</h1><p class="intro-description">An experiment is a method; a run records one dated execution with its parameters, inputs, outputs and code version. Only explicit runs appear here.</p><nav class="catalog-nav" aria-label="Research catalog navigation"><a href={url('/research/')}>Research</a><a href={url('/datasets/')}>Datasets</a><a href={url('/provenance/')}>Provenance</a><a href={url('/packages/')}>Packages</a></nav></header>
    <dl class="catalog-stats" aria-label="Experiment run statistics"><div><dt>Experiments</dt><dd>{experiments.length}</dd></div><div><dt>Recorded runs</dt><dd>{summary.total}</dd></div><div><dt>Completed</dt><dd>{summary.completed}</dd></div><div><dt>Failed</dt><dd>{summary.failed}</dd></div><div><dt>Success rate</dt><dd>{summary.successRate == null ? '—' : `${Math.round(summary.successRate * 100)}%`}</dd></div></dl>
    {experiments.length ? <>
      <div class="catalog-controls" data-pagefind-ignore><label><span>Search experiments</span><input type="search" data-experiment-query placeholder="Title, research or run…" /></label><label><span>Run status</span><select data-experiment-filter><option value="">All statuses</option>{['Planned','Running','Completed','Failed','Cancelled'].map(status => <option value={status}>{status}</option>)}</select></label></div>
      <div class="catalog-list" data-experiment-list>
        {experiments.map(experiment => <article class="catalog-card experiment-card" data-experiment-card data-search={[experiment.title, experiment.researchTitle, ...experiment.runs.flatMap(run => [run.title, run.status, run.notes])].join(' ').toLocaleLowerCase()} data-status={experiment.runs.length ? experiment.runs[experiment.runs.length - 1]?.status : experiment.status}>
          <div class="catalog-card-heading"><div><p class="eyebrow">{experiment.status} · {experiment.researchTitle}</p><h2>{experiment.title}</h2></div><a class="text-link" href={url(experiment.researchPath)}>Workspace →</a></div>
          {experiment.runs.length ? <div class="run-list">{experiment.runs.map(run => <div class="run-row"><div><strong>{run.title}</strong><p class="catalog-muted">{run.status}{run.startedAt && ` · ${formatDate(run.startedAt)}`}</p></div><div class="run-facts"><span>{run.inputFiles.length} inputs</span><span>{run.outputFiles.length} outputs</span><span>{Object.keys(run.parameters).length} parameters</span>{run.codeVersion.commitSha && <code>{run.codeVersion.commitSha.slice(0, 10)}</code>}</div>{run.notes && <p class="run-notes">{run.notes}</p>}</div>)}</div> : <p class="catalog-empty-inline">No explicit runs recorded. Add a run inside the Research workspace when an execution has actually occurred.</p>}
        </article>)}
      </div>
      <p class="catalog-empty" data-experiment-empty hidden>No experiment matches those filters.</p>
    </> : <section class="catalog-empty"><h2>No experiments recorded yet.</h2><p>When you have a real method or analysis to track, add an Experiment to its Research workspace. A run will appear here only after you record it explicitly; the site will never infer a result from a task or log.</p><a class="button-secondary" href={url('/research/')}>Open Research →</a></section>}
  </main>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-experiment-catalog]');
  const query = root?.querySelector<HTMLInputElement>('[data-experiment-query]');
  const filter = root?.querySelector<HTMLSelectElement>('[data-experiment-filter]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-experiment-card]') || [])];
  const empty = root?.querySelector<HTMLElement>('[data-experiment-empty]');
  function apply() { const term = (query?.value || '').trim().toLocaleLowerCase(); let shown = 0; for (const card of cards) { const ok = (!term || (card.dataset.search || '').includes(term)) && (!filter?.value || card.dataset.status === filter.value); card.hidden = !ok; if (ok) shown++; } if (empty) empty.hidden = shown !== 0; }
  query?.addEventListener('input', apply); filter?.addEventListener('change', apply);
</script>
<style>
  .catalog-page{padding:3.2rem 0 5rem}.catalog-header h1{font-size:clamp(2.7rem,6vw,4.6rem);letter-spacing:-.06em;margin:.7rem 0 1rem}.catalog-header .intro-description{max-width:720px}.catalog-nav{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:1.5rem;font-size:.78rem}.catalog-nav a{color:var(--accent)}.catalog-stats{display:flex;flex-wrap:wrap;gap:1.3rem 3rem;border-block:1px solid var(--line);padding:1.15rem 0;margin:2.3rem 0}.catalog-stats div{display:grid;gap:.25rem}.catalog-stats dt{font-size:.7rem;color:var(--muted)}.catalog-stats dd{font:500 1.2rem var(--font-mono);margin:0}.catalog-controls{display:grid;grid-template-columns:minmax(220px,1fr) 220px;gap:.75rem;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1rem;margin-bottom:1.4rem}.catalog-controls label{display:grid;gap:.35rem}.catalog-controls span{font-size:.72rem;color:var(--muted)}.catalog-controls input,.catalog-controls select{width:100%;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:.62rem .7rem;color:var(--ink);font:inherit}.catalog-list{display:grid;gap:1rem}.catalog-card{border:1px solid var(--line);border-radius:10px;padding:1.25rem;background:var(--surface)}.catalog-card[hidden],.catalog-empty[hidden]{display:none}.catalog-card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.catalog-card h2{font-size:1.35rem;margin:.35rem 0 .8rem}.run-list{border-top:1px solid var(--line);margin-top:1rem}.run-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.3rem 1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.run-row:last-child{border-bottom:0}.run-row strong{font-weight:600}.catalog-muted{font-size:.75rem;color:var(--muted);margin:.3rem 0}.run-facts{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.4rem .8rem;color:var(--muted);font-size:.72rem}.run-facts code{font-family:var(--font-mono)}.run-notes{grid-column:1/-1;margin:.45rem 0 0;color:var(--muted);font-size:.85rem}.catalog-empty-inline{font-size:.85rem;color:var(--muted);margin:.8rem 0 0}.catalog-empty{border:1px dashed var(--line);padding:2rem;border-radius:10px;color:var(--muted)}.catalog-empty h2{color:var(--ink);margin-top:0}@media(max-width:600px){.catalog-page{padding-top:2rem}.catalog-controls{grid-template-columns:1fr}.catalog-card-heading{display:block}.run-row{grid-template-columns:1fr}.run-facts{justify-content:flex-start}}
</style>
