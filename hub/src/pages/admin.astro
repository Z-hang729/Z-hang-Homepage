---
import BaseLayout from '../layouts/BaseLayout.astro';
const local = import.meta.env.DEV;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Local administration" description="Edit the academic hub locally, then review and publish through Git." noindex>
  <main class="admin-shell" data-admin-root data-local={String(local)} data-base={base}>
    <p class="eyebrow">CONTENT WORKSPACE</p>
    <h1>Local administration<span>.</span></h1>
    <p class="admin-intro">个人资料、科研日志和课程资料都保存在文本文件中。保存后可立即预览，再通过 Git 发布。</p>
    {!local ? <section class="notice"><h2>公开版本为只读页面</h2><p>本地编辑器仅在电脑上运行 <code>npm run dev</code> 或 <code>npm run admin</code> 时开放。GitHub Pages 没有写入 API、账户密钥或编辑权限。</p><a href={`${base}about/`}>返回个人简介 →</a></section> : <>
      <p class="notice compact">本地编辑 · 原始文件保存 · 修改前检查版本 · 发布前运行 <code>npm run build</code></p>
      <p id="admin-status" role="status" aria-live="polite">正在连接本地编辑器…</p>
      <div class="admin-grid">
        <aside class="admin-panel file-panel"><h2>内容文件</h2><p>Profile、导航和时间轴使用 YAML；项目与日志使用 Markdown。</p><button id="admin-refresh" type="button">刷新文件列表</button><ul id="admin-files" aria-label="可编辑文件"></ul></aside>
        <section class="admin-panel editor-panel"><h2>文件编辑器</h2><label for="admin-path">文件路径</label><input id="admin-path" placeholder="src/data/profile.yaml" autocomplete="off" spellcheck="false" /><p class="field-hint">可创建 src/content/research、notes、projects 或 logs 下的 Markdown 文件。科研日志路径：src/content/logs/项目 slug/YYYY-MM-DD.md。</p><label for="admin-content">YAML / Markdown 内容</label><textarea id="admin-content" rows="24" spellcheck="false" placeholder="从左侧选择文件，或输入新路径并创建模板。"></textarea><div class="admin-actions"><button id="admin-save" type="button" class="primary">保存文件</button><button id="admin-create" type="button">新建模板</button><button id="admin-reload" type="button">重新加载</button></div><p id="admin-editor-state" class="field-hint">尚未选择文件。</p></section>
      </div>
      <section class="admin-panel import-panel"><div><p class="eyebrow">ACADEMIC CONTENT</p><h2>新建学术条目</h2><p>填写信息后生成 Markdown 模板，在上方编辑器检查并保存。文件和文件夹统一通过 Owner Library 上传、预览和关联。</p><div class="admin-actions"><a class="button-secondary" href={`${base}owner/`}>打开 Owner 上传工作台 ↗</a><a class="button-secondary" href={`${base}files/`}>浏览 Academic File Library ↗</a></div></div>
        <form id="admin-entry-form"><div class="import-fields"><label>条目类型<select name="kind"><option value="research">Research</option><option value="notes">Notes</option><option value="projects">Project</option></select></label><label>标题<input name="title" required maxlength="200" placeholder="Space Plasma Physics" /></label><label>简介<input name="description" placeholder="填写简短介绍" maxlength="2000" /></label><label>Tags<input name="tags" placeholder="Plasma Physics, Python" /></label><label>Semester<input name="semester" placeholder="2026 Fall" /></label><label>Status<select name="status"><option>Planning</option><option>In Progress</option><option>Completed</option><option>Paused</option></select></label><label>Category<select name="category"><option>Space Physics</option><option>Physics</option><option>Mathematics</option><option>Computer Science</option><option>General Education</option><option>Others</option></select></label><label>URL slug（可选）<input name="slug" placeholder="space-plasma-physics" /></label></div>
          <p class="field-hint">此处只生成文字内容；任意类型的原件上传请使用 Owner Library。</p><button id="admin-entry-create" class="primary" type="submit">生成条目模板</button>
        </form>
      </section>
    </>}
  </main>
  {local && <script is:inline type="module" src={`${base}admin.js`}></script>}
</BaseLayout>
<style>
  .admin-shell{width:min(1180px,calc(100% - 3rem));margin:0 auto;padding:4rem 0 6rem}.eyebrow{font-size:.72rem;letter-spacing:.17em;font-weight:700;color:var(--accent,#277a8c)}h1{font-size:clamp(2.3rem,5vw,4rem);letter-spacing:-.055em;margin:.65rem 0}h1 span{color:var(--accent,#277a8c)}.admin-intro{max-width:740px;color:var(--muted,#65737e);line-height:1.8}.admin-grid{display:grid;grid-template-columns:280px 1fr;gap:1.2rem;margin:1.8rem 0}.admin-panel,.notice{border:1px solid var(--border,#d9e0e4);border-radius:16px;background:var(--surface,#fff);padding:1.5rem}.notice{margin:2rem 0;line-height:1.8}.compact{padding:.8rem 1.2rem;font-size:.84rem}.admin-panel h2{font-size:1.2rem;margin:0 0 .7rem}.admin-panel p{font-size:.87rem;line-height:1.6;color:var(--muted,#65737e)}label{display:block;font-size:.82rem;font-weight:600;margin:.9rem 0 .4rem}input,select,textarea{display:block;width:100%;box-sizing:border-box;padding:.72rem;border:1px solid var(--border,#d9e0e4);border-radius:7px;background:var(--bg,#f8fafb);color:var(--text,#17252d);font:inherit;font-size:.88rem}textarea{font: .84rem/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:2;resize:vertical}button{cursor:pointer;font:inherit;font-size:.82rem;border:1px solid var(--border,#d9e0e4);background:var(--bg,#f8fafb);color:var(--text,#17252d);padding:.65rem .85rem;border-radius:7px}button:disabled{opacity:.5;cursor:wait}.primary{background:var(--accent,#277a8c);color:#fff;border-color:transparent}.admin-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.field-hint{font-size:.76rem!important}.file-panel ul{list-style:none;margin:1rem 0 0;padding:0;max-height:640px;overflow:auto}.file-panel li{margin-bottom:.35rem}.file-panel li button{text-align:left;width:100%;overflow-wrap:anywhere;font: .73rem/1.5 ui-monospace,Consolas,monospace}.file-panel li button[aria-current="true"]{border-color:var(--accent,#277a8c);color:var(--accent,#277a8c)}.import-panel{margin-top:2rem}.import-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:.1rem 1.2rem}#admin-dropzone{display:flex;align-items:center;flex-direction:column;gap:.5rem;border:1px dashed var(--accent,#277a8c);border-radius:12px;padding:2rem 1rem;margin:1.7rem 0 1rem;text-align:center;cursor:pointer;background:var(--bg,#f8fafb)}#admin-dropzone span{font-size:.78rem;color:var(--muted,#65737e)}#admin-dropzone.drag-active{outline:3px solid var(--accent,#277a8c)}#admin-folder{width:auto;max-width:100%;padding:.5rem}#admin-status{min-height:1.5rem;font-size:.84rem;color:var(--accent,#277a8c)}#admin-status[data-error="true"]{color:#b2403c}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,#admin-dropzone:focus-visible{outline:2px solid var(--accent,#277a8c);outline-offset:3px}@media(max-width:800px){.admin-grid{grid-template-columns:1fr}.file-panel ul{max-height:210px}.import-fields{grid-template-columns:1fr}.admin-shell{width:calc(100% - 2rem);padding-top:2.5rem}.admin-panel{padding:1rem}}
</style>
