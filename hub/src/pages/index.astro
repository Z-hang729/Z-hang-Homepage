---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import Magnetosphere from '../components/Magnetosphere.astro';
import Icon from '../components/Icon.astro';
import {profile,url,formatDate} from '../lib/site';
const research=(await getCollection('research')).filter(e=>e.data.featured).sort((a,b)=>+new Date(b.data.updated)-+new Date(a.data.updated)).slice(0,3);
const notes=(await getCollection('notes')).sort((a,b)=>+new Date(b.data.updated)-+new Date(a.data.updated)).slice(0,3);
const logs=(await getCollection('logs')).sort((a,b)=>+new Date(b.data.date)-+new Date(a.data.date)).slice(0,3);
const projects=(await getCollection('projects')).filter(e=>e.data.featured).slice(0,2);
---
<BaseLayout title="An academic garden"><div class="container"><section class="hero"><div class="hero-topline"><p class="eyebrow" style="margin:0">THE ACADEMIC GARDEN <span style="color:var(--muted)">/ 01</span></p><span class="availability">Ideas, always in progress.</span></div><div class="hero-grid"><div><h1>{profile.heroFirstLine}<br/><em>{profile.heroSecondLine}</em></h1><p class="hero-subtitle"><strong>{profile.displayName} · {profile.university}</strong><br/>{profile.role}<br/>{profile.degree} × {profile.secondDegreeShort}</p><div class="hero-actions"><a class="button" href={url('/research/')}>Explore research <Icon name="arrow" size={16}/></a><a class="button-secondary" href={url('/notes/')}>Open the notebook <Icon name="book" size={16}/></a></div></div><Magnetosphere/></div><div class="currently-bar"><p class="eyebrow">CURRENTLY</p><div class="currently-items">{profile.currently.map((item:any)=><div class="currently-item"><span>{item.label}</span><strong>{item.text}</strong></div>)}</div></div></section>
<section class="about-strip"><div><p class="eyebrow">A LITTLE CONTEXT</p><h2>Curiosity, connected.</h2><a class="text-link" href={url('/about/')}>More about me <Icon name="arrow" size={15}/></a></div><div><p class="bio">{profile.bio}</p><div class="interests">{profile.researchInterests.map((interest:string)=><span class="interest">{interest}</span>)}</div></div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow"><span class="section-number">01</span>QUESTIONS WORTH ASKING</p><h2>Selected research</h2></div><a class="text-link" href={url('/research/')}>All research <Icon name="arrow" size={16}/></a></div><div class="card-grid">{research.map(entry=><ContentCard entry={entry}/>)}</div></section>
<section class="updates-section two-column"><div><div class="section-heading"><div><p class="eyebrow"><span class="section-number">02</span>FROM THE LAB NOTEBOOK</p><h2>Research updates</h2></div><a class="text-link" href={url('/research/')}>View all <Icon name="arrow" size={15}/></a></div>{logs.map(log=><a class="update-row" href={url(`/research/${log.data.project}/#research-log`)}><time datetime={new Date(log.data.date).toISOString()}>{formatDate(log.data.date)}</time><div><h3>{log.data.title}</h3><p>{log.data.demo && <span class="demo-inline">DEMO</span>}{log.data.project.replace(/-/g,' ')}</p></div></a>)}{!logs.length&&<p class="muted">Research logs will appear here as they grow.</p>}</div><div><div class="section-heading"><div><p class="eyebrow"><span class="section-number">03</span>LEARNING IN THE OPEN</p><h2>Recent notes</h2></div><a class="text-link" href={url('/notes/')}>All notes <Icon name="arrow" size={15}/></a></div>{notes.map(note=><a class="update-row" href={url(`/notes/${note.id}/`)}><time datetime={new Date(note.data.updated).toISOString()}>{formatDate(note.data.updated)}</time><div><h3>{note.data.title}</h3><p>{note.data.demo&&<span class="demo-inline">DEMO</span>}{note.data.category} · {note.data.semester}</p></div></a>)}</div></section>
<section class="timeline-home"><div><p class="eyebrow">A PATH, STILL UNFOLDING</p><h2>Along the way.</h2></div><div>{profile.timeline.map((item:any)=><div class="timeline-entry"><time>{item.date}</time><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow"><span class="section-number">04</span>IDEAS INTO TOOLS</p><h2>Things I build</h2></div><a class="text-link" href={url('/projects/')}>All projects <Icon name="arrow" size={16}/></a></div><div class="two-column">{projects.map(entry=><ContentCard entry={entry} compact/>)}</div></section>
<section class="contact-section" id="contact"><div><p class="eyebrow">CONVERSATIONS START HERE</p><h2>Let’s connect.</h2><p>Questions, ideas, or a shared curiosity about the Sun and space.</p></div><div class="contact-links">{profile.email && <a class="button" href={`mailto:${profile.email}`}><Icon name="mail" size={16}/>Send an email</a>}{profile.github && <a class="button-secondary" href={profile.github}><Icon name="github" size={17}/>GitHub <Icon name="diagonal" size={15}/></a>}{!profile.email&&!profile.github&&<p class="muted">Public contact details will be added here.</p>}</div></section></div></BaseLayout>
