---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import { homepageSections } from '../lib/site';
import type { HomepageSection } from '../lib/site';
import { sortLatest } from '../lib/content';
const research = sortLatest((await getCollection('research')).filter(entry => entry.data.featured)).slice(0, 3);
const notes = sortLatest(await getCollection('notes')).slice(0, 3);
const logs = sortLatest(await getCollection('logs')).slice(0, 3);
const projects = sortLatest((await getCollection('projects')).filter(entry => entry.data.featured)).slice(0, 2);
const sections = homepageSections.filter(section => section.visible);
type SectionGroup = { section: HomepageSection; focus?: HomepageSection; columns?: HomepageSection[] };
const groups: SectionGroup[] = [];
for (let i = 0; i < sections.length; i++) {
  const section = sections[i];
  const next = sections[i + 1];
  if (section.id === 'hero' && next?.id === 'current-focus') { groups.push({ section, focus: next }); i++; }
  else if (['research-updates', 'notes'].includes(section.id)) {
    const columns = [section];
    if (next && ['research-updates', 'notes'].includes(next.id)) { columns.push(next); i++; }
    groups.push({ section, columns });
  } else groups.push({ section });
}
---
<BaseLayout title="An academic garden">
  <div class="container" data-owner-homepage>
    {groups.map(group => group.columns ? <section class:list={['updates-section', { 'two-column': group.columns.length > 1 }]}>{group.columns.map(section => <HomeSection section={section} research={research} notes={notes} logs={logs} projects={projects}/>)}</section> : <HomeSection section={group.section} focusSection={group.focus} research={research} notes={notes} logs={logs} projects={projects}/>)}
  </div>
</BaseLayout>
