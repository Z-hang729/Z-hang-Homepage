---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/site';
import { getFiles } from '../../lib/file-records';
import { buildDatasetCatalog, datasetCatalogSummary, datasetFacets } from '../../lib/dataset-catalog.mjs';

const entries = await getCollection('research');
const catalog = buildDatasetCatalog(entries as any, { files: getFiles() as any });
const summary = datasetCatalogSummary(catalog);
const facets = datasetFacets(catalog);
const filePath = (id: string) => url(`/files/${String(id).replace(/^file:/, '')}/`);
---
<BaseLayout title="Dataset catalog" description="Research datasets and their stable File Library lineage.">
  <main class="container catalog-page dataset-catalog" data-dataset-catalog>
    <header class="page-intro catalog-header">
      <p class="eyebrow">RESEARCH DATASETS</p>
      <h1>Dataset catalog.</h1>
      <p class="intro-description">Observation metadata, source context and File Library lineage in one read-only view. The catalog never duplicates original data.</p>
      <nav class="catalog-nav" aria-label="Research catalog navigation"><a href={url('/research/')}>Research</a><a href={url('/experiments/')}>Experiments</a><a href={url('/provenance/')}>Provenance</a><a href={url('/files/')}>File Library</a></nav>
    </header>
    <dl class="catalog-stats" aria-label="Dataset catalog statistics"><div><dt>Datasets</dt><dd>{summary.total}</dd></div><div><dt>With files</dt><dd>{summary.withFiles}</dd></div><div><dt>Missing file links</dt><dd>{summary.missingFiles}</dd></div><div><dt>Changed file snapshots</dt><dd>{summary.changedFiles}</dd></div></dl>
    {catalog.length ? <>
      <div class="catalog-controls" data-pagefind-ignore>
        <label><span>Search datasets</span><input type="search" data-catalog-query placeholder="Name, instrument, wavelength or research…" /></label>
        <label><span>Type</span><select data-catalog-filter="type"><option value="">All types</option>{facets.types.map(value => <option value={value}>{value}</option>)}</select></label>
        <label><span>Instrument</span><select data-catalog-filter="instrument"><option value="">All instruments</option>{facets.instruments.map(value => <option value={value}>{value}</option>)}</select></label>
        <label><span>Research</span><select data-catalog-filter="research"><option value="">All research</option>{facets.research.map(value => <option value={value}>{value}</option>)}</select></label>
      </div>
      <div class="catalog-list" data-catalog-list>
        {catalog.map(dataset => <article class="catalog-card" data-catalog-card data-name={[dataset.name, dataset.type, dataset.instrument, dataset.wavelength, ...dataset.tags, ...dataset.relatedResearch].join(' ').toLocaleLowerCase()} data-type={dataset.type} data-instrument={dataset.instrument} data-research={dataset.relatedResearch.join(' ')}>
          <div class="catalog-card-heading"><div><p class="eyebrow">{dataset.type}</p><h2>{dataset.name}</h2></div><span class={`catalog-status status-${dataset.status.toLocaleLowerCase().replaceAll(' ', '-')}`}>{dataset.status}</span></div>
          {dataset.description && <p>{dataset.description}</p>}
          <dl class="catalog-meta">{dataset.instrument && <><dt>Instrument</dt><dd>{dataset.instrument}</dd></>}{dataset.observationTime && <><dt>Observation</dt><dd>{dataset.observationTime}</dd></>}{dataset.wavelength && <><dt>Wavelength</dt><dd>{dataset.wavelength}</dd></>}{dataset.resolution && <><dt>Resolution</dt><dd>{dataset.resolution}</dd></>}{dataset.cadence && <><dt>Cadence</dt><dd>{dataset.cadence}</dd></>}{dataset.license && <><dt>License</dt><dd>{dataset.license}</dd></>}{dataset.version && <><dt>Version</dt><dd>{dataset.version}</dd></>}</dl>
          <div class="catalog-links"><span>{dataset.id}</span>{dataset.relatedResearch.map((id: string) => <a href={url(`/research/${id.replace(/^research:/, '')}/`)}>{id}</a>)}{dataset.fileRefs?.map((item: any) => item.file ? <a href={filePath(item.id)}>{item.file.displayName || item.id}</a> : <span class="catalog-missing">Missing {item.id}</span>)}</div>
        </article>)}
      </div>
      <p class="catalog-empty" data-catalog-empty hidden>No dataset matches those filters.</p>
    </> : <section class="catalog-empty"><h2>No datasets recorded yet.</h2><p>Create a Dataset entry inside an existing Research workspace when you have a real observation or simulation to document. Existing File Library records will be attached by ID; bytes are never duplicated here.</p><a class="button-secondary" href={url('/research/')}>Open Research →</a></section>}
  </main>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-dataset-catalog]');
  const query = root?.querySelector<HTMLInputElement>('[data-catalog-query]');
  const controls = [...(root?.querySelectorAll<HTMLSelectElement>('[data-catalog-filter]') || [])];
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-catalog-card]') || [])];
  const empty = root?.querySelector<HTMLElement>('[data-catalog-empty]');
  function apply() { const term = (query?.value || '').trim().toLocaleLowerCase(); let shown = 0; for (const card of cards) { const text = card.dataset.name || ''; const ok = (!term || text.includes(term)) && controls.every(control => { const key = control.dataset.catalogFilter || ''; const value = key === 'research' ? (card.dataset.research || '') : card.getAttribute(`data-${key}`) || ''; return !control.value || value === control.value || key === 'research' && value.includes(control.value); }); card.hidden = !ok; if (ok) shown++; } if (empty) empty.hidden = shown !== 0; }
  query?.addEventListener('input', apply); controls.forEach(control => control.addEventListener('change', apply));
</script>
<style>
  .catalog-page{padding:3.2rem 0 5rem}.catalog-header h1{font-size:clamp(2.7rem,6vw,4.6rem);letter-spacing:-.06em;margin:.7rem 0 1rem}.catalog-header .intro-description{max-width:700px}.catalog-nav{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:1.5rem;font-size:.78rem}.catalog-nav a{color:var(--accent)}.catalog-stats{display:flex;flex-wrap:wrap;gap:1.3rem 3rem;border-block:1px solid var(--line);padding:1.15rem 0;margin:2.3rem 0}.catalog-stats div{display:grid;gap:.25rem}.catalog-stats dt{font-size:.7rem;color:var(--muted)}.catalog-stats dd{font:500 1.2rem var(--font-mono);margin:0}.catalog-controls{display:grid;grid-template-columns:minmax(220px,2fr) repeat(3,minmax(130px,1fr));gap:.75rem;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1rem;margin-bottom:1.4rem}.catalog-controls label{display:grid;gap:.35rem}.catalog-controls span{font-size:.72rem;color:var(--muted)}.catalog-controls input,.catalog-controls select{width:100%;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:.62rem .7rem;color:var(--ink);font:inherit}.catalog-list{display:grid;gap:1rem}.catalog-card{border:1px solid var(--line);border-radius:10px;padding:1.25rem;background:var(--surface)}.catalog-card[hidden],.catalog-empty[hidden]{display:none}.catalog-card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.catalog-card h2{font-size:1.35rem;margin:.35rem 0 .8rem}.catalog-status{font-size:.68rem;border:1px solid var(--line);border-radius:999px;padding:.25rem .55rem;color:var(--muted);white-space:nowrap}.catalog-meta{display:grid;grid-template-columns:130px minmax(0,1fr);gap:.45rem .8rem;margin:1rem 0;font-size:.82rem}.catalog-meta dt{color:var(--muted)}.catalog-meta dd{margin:0;overflow-wrap:anywhere}.catalog-links{display:flex;flex-wrap:wrap;gap:.45rem .8rem;border-top:1px solid var(--line);padding-top:.75rem;font: .72rem var(--font-mono);overflow-wrap:anywhere}.catalog-links a{color:var(--accent)}.catalog-missing{color:var(--solar)}.catalog-empty{border:1px dashed var(--line);padding:2rem;border-radius:10px;color:var(--muted)}.catalog-empty h2{color:var(--ink);margin-top:0}@media(max-width:800px){.catalog-controls{grid-template-columns:1fr 1fr}.catalog-controls label:first-child{grid-column:1/-1}}@media(max-width:520px){.catalog-page{padding-top:2rem}.catalog-controls{grid-template-columns:1fr}.catalog-card-heading{display:block}.catalog-status{display:inline-block}.catalog-meta{grid-template-columns:100px minmax(0,1fr)}}
</style>
