---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {readAcademicRecords} from '../../lib/academic-records.mjs';
import {normalizeFigure,figurePath} from '../../lib/figures.mjs';
import {getFiles} from '../../lib/file-records';
import {url,formatDate} from '../../lib/site';
import '../../styles/academic-publishing.css';
const files=getFiles(),index=new Map(files.map(file=>[file.id,file]));
const figures=readAcademicRecords('figures',{publicOnly:true}).map(record=>normalizeFigure(record,{files})).sort((a,b)=>b.date.localeCompare(a.date)||a.id.localeCompare(b.id));
const categories=[...new Set(figures.map(figure=>figure.category))].sort(),tags=[...new Set(figures.flatMap(figure=>figure.tags))].sort(),research=[...new Set(figures.flatMap(figure=>figure.relatedResearch||[]))].sort();
---
<BaseLayout title="Scientific Figures Gallery" description="Scientific images, visualizations and research results with provenance and links to original files.">
 <div class="pub-shell" data-owner-figures data-figures-gallery data-figures={JSON.stringify(figures)}>
  <header class="pub-header"><p class="eyebrow">RESEARCH ASSETS</p><h1>Scientific Figures Gallery</h1><p>Scientific images, visualizations and results, with captions, provenance and links to original files.</p><nav class="pub-nav" aria-label="Academic publishing"><a href={url('/files/')}>File Library</a><a href={url('/packages/')}>Research packages</a><a href={url('/references/')}>Bibliography</a><a href={url('/activity/')}>Activity</a></nav></header>
  {figures.length===0?<section class="pub-empty"><h2>Figures as research progresses</h2><p>Scientific figures will appear here as research progresses.</p><p>Each figure will reference its original Library file and include a scientific caption and provenance.</p></section>:<>
   <form class="pub-filters" role="search" onsubmit="return false"><label>Search <input type="search" name="query" placeholder="Title, caption or author"/></label><label>Category <select name="category"><option value="">All categories</option>{categories.map(value=><option value={value}>{value}</option>)}</select></label><label>Tag <select name="tag"><option value="">All tags</option>{tags.map(value=><option value={value}>{value}</option>)}</select></label><label>Research <select name="research"><option value="">All research</option>{research.map(value=><option value={value}>{value.replace(/^research:/,'')}</option>)}</select></label><label>From <input type="date" name="from"/></label><label>To <input type="date" name="to"/></label><label>Sort <select name="sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title</option></select></label><label>View <select name="view"><option value="grid">Grid</option><option value="list">List</option></select></label></form>
   <p class="pub-count" role="status" aria-live="polite" data-figure-count>{figures.length} figures</p>
   <div class="pub-grid" data-figure-grid>{figures.map(figure=>{const original=index.get(figure.fileId),thumbnail=index.get(figure.thumbnailId||figure.fileId),safe=thumbnail?.previewType==='image';return <article class="pub-card figure-card" data-figure-card={figure.id}><a class="figure-image" href={url(figurePath(figure))}>{safe?<img src={url(thumbnail.previewUrl||thumbnail.downloadUrl)} alt={figure.altText} loading="lazy" decoding="async" referrerpolicy="no-referrer"/>:<span class="figure-preview-fallback">Open scientific image preview →</span>}</a><div><p class="pub-meta"><time datetime={figure.date}>{formatDate(figure.date)}</time> · {figure.category}</p><h2><a href={url(figurePath(figure))}>{figure.title}</a></h2><p class="figure-excerpt">{figure.caption}</p><p class="pub-meta">{figure.tags.join(' · ')}</p><div class="pub-actions"><a href={url(figurePath(figure))}>View figure →</a>{original&&<a href={url(original.downloadUrl)} download={original.originalName}>Original ↓</a>}<button type="button" class="button-secondary" data-figure-copy={url(figurePath(figure))}>Copy link</button></div></div></article>;})}</div>
   <p class="pub-empty" data-figure-no-results hidden>No figures match these filters.</p><p role="status" aria-live="polite" data-figure-copy-status/>
  </>}
 </div>
</BaseLayout>
<script>
 import {filterFigures} from '../../lib/figures.mjs';
 const root=document.querySelector<HTMLElement>('[data-figures-gallery]'),form=root?.querySelector<HTMLFormElement>('form'),grid=root?.querySelector<HTMLElement>('[data-figure-grid]');
 if(root&&form&&grid){const figures=JSON.parse(root.dataset.figures||'[]'),cards=new Map([...grid.querySelectorAll<HTMLElement>('[data-figure-card]')].map(card=>[card.dataset.figureCard,card]));const refresh=()=>{const values=Object.fromEntries(new FormData(form).entries()),matches=filterFigures(figures,values),ids=new Set(matches.map((figure:any)=>figure.id));cards.forEach((card,id)=>card.hidden=!ids.has(id));matches.forEach((figure:any)=>grid.append(cards.get(figure.id)!));grid.dataset.view=String(values.view||'grid');root.querySelector('[data-figure-count]')!.textContent=`${matches.length} figure${matches.length===1?'':'s'}`;root.querySelector<HTMLElement>('[data-figure-no-results]')!.hidden=matches.length>0;};form.addEventListener('input',refresh);form.addEventListener('change',refresh);root.querySelectorAll<HTMLButtonElement>('[data-figure-copy]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(new URL(button.dataset.figureCopy!,location.origin).href);root.querySelector('[data-figure-copy-status]')!.textContent='Figure link copied.';}catch{root.querySelector('[data-figure-copy-status]')!.textContent='Copy is unavailable. Open the figure and copy its address.';}}));}
</script>
<style>.figure-image{display:flex;align-items:center;justify-content:center;min-height:190px;margin:-.5rem -.5rem 1rem;background:var(--bg);border-radius:5px;overflow:hidden}.figure-image img{width:100%;max-height:320px;object-fit:contain}.figure-preview-fallback{padding:2rem;color:var(--muted)}.figure-excerpt{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.figure-card[hidden]{display:none}.pub-actions{font-size:.8rem}.pub-filters label{display:grid;gap:.3rem;font-size:.75rem}.pub-grid[data-view=list]{display:block}.pub-grid[data-view=list] .figure-card{display:grid;grid-template-columns:minmax(160px,28%) 1fr;gap:1.5rem;margin-bottom:1rem}.pub-grid[data-view=list] .figure-image{margin:0}@media(max-width:600px){.pub-grid[data-view=list] .figure-card{display:block}}</style>
