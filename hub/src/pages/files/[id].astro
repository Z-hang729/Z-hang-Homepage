---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeConnections from '../../components/KnowledgeConnections.astro';
import {getFiles} from '../../lib/file-records';
import {allEntries} from '../../lib/content';
import {formatFileSize,stableFilePath,originalDownloadURL,fileRelations,fileGroup} from '../../lib/files.mjs';
import {url,formatDate} from '../../lib/site';
import {renderFileDescription} from '../../file-preview/description.mjs';
import {plainDescription,FILE_GROUP_LABELS,FILE_CATEGORY_LABELS} from '../../file-preview/library-model.mjs';
export function getStaticPaths(){return getFiles({includeUnlisted:true}).map(file=>({params:{id:file.id},props:{file}}));}
interface Props{file:any;}
const {file}=Astro.props;
const entries=await allEntries(),related=['research','notes','projects'].flatMap(kind=>fileRelations(file,kind).map((slug:string)=>{const entry=entries.find(item=>item.collection===kind&&item.id===slug);return {kind,slug,title:entry?.data.title||slug};}));
const description=await renderFileDescription(file.description,import.meta.env.BASE_URL),group=fileGroup(file),value=(input:any)=>Array.isArray(input)?input.join(' × '):typeof input==='object'?JSON.stringify(input):String(input);
const scientific=[['Dataset type',file.datasetType],['Instrument',file.instrument],['Telescope',file.telescope],['Observation date',file.observationDate],['Observation time',file.observationTime],['Wavelength',file.wavelength],['Cadence',file.cadence],['Dimensions',file.dimensions],['Units',file.units]].filter(([,input])=>input!==undefined&&input!==null&&input!=='');
---
<BaseLayout title={file.displayName} description={plainDescription(file.description).slice(0,220)||`Preview and download ${file.originalName}.`} noindex={file.visibility==='unlisted'}>
 <div class="container section file-detail" data-file-detail data-file-id={file.id} data-file-preview={JSON.stringify(file)} data-pagefind-ignore={file.visibility==='unlisted'?'':undefined}>
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">/</span><a href={url('/files/')}>Library</a><span aria-hidden="true">/</span><span aria-current="page">{file.displayName}</span></nav>
  <header class="file-detail-header"><p class="eyebrow">{FILE_GROUP_LABELS[group]||'ORIGINAL FILE'} / {FILE_CATEGORY_LABELS[file.category]||'General'}</p><h1 data-pagefind-meta="title">{file.displayName}</h1><p class="file-detail-summary">{file.extension.toUpperCase()||'FILE'} · {formatFileSize(file.size)} <span>Updated <time datetime={file.updatedAt}>{formatDate(file.updatedAt)}</time></span></p>{file.description&&<div class="file-description prose" set:html={description}/>}</header>
  <div class="file-detail-actions" data-pagefind-ignore><a class="button-secondary" href={url(originalDownloadURL(file))} download={file.originalName}>Download original ↓</a><button type="button" class="button-secondary" data-file-copy={url(stableFilePath(file.id))}>Copy file page link</button><button type="button" class="button-secondary" data-preview-load>Open preview</button><button type="button" class="button-secondary" data-preview-fullscreen hidden>Full screen</button></div>
  <p data-file-status role="status" aria-live="polite" data-pagefind-ignore></p><div class="file-preview prose" data-preview-host data-pagefind-ignore></div>
  <section class="file-information" aria-labelledby="file-information-heading"><h2 id="file-information-heading">File information</h2>
   <dl class="file-metadata"><dt>Original filename</dt><dd>{file.originalName}</dd><dt>Folder path</dt><dd>{file.relativePath}</dd><dt>Size</dt><dd>{formatFileSize(file.size)} <small>({file.size.toLocaleString('en-US')} bytes)</small></dd><dt>Type</dt><dd>{file.extension.toUpperCase()||'FILE'} <small>{file.mimeType}</small></dd><dt>Uploaded</dt><dd><time datetime={file.uploadedAt}>{formatDate(file.uploadedAt)}</time></dd><dt>Updated</dt><dd><time datetime={file.updatedAt}>{formatDate(file.updatedAt)}</time></dd>{file.version&&<><dt>Version</dt><dd>{value(file.version)}</dd></>}{file.sha256&&<><dt>SHA-256</dt><dd><code>{file.sha256}</code></dd></>}{file.tags.length>0&&<><dt>Tags</dt><dd class="file-detail-tags">{file.tags.map((tag:string)=><a href={`${url('/files/')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</dd></>}{file.authors?.length>0&&<><dt>Authors</dt><dd>{file.authors.join(', ')}</dd></>}{file.year&&<><dt>Year</dt><dd>{file.year}</dd></>}{file.doi&&<><dt>DOI</dt><dd><a href={`https://doi.org/${encodeURIComponent(file.doi)}`} rel="noopener noreferrer">{file.doi} ↗</a></dd></>}{file.license&&<><dt>License</dt><dd>{file.license}</dd></>}{file.createdBy&&<><dt>Added by</dt><dd>{value(file.createdBy)}</dd></>}</dl>
  </section>
  {related.length>0&&<section class="file-related-section" aria-labelledby="file-related-heading"><h2 id="file-related-heading">Related content</h2><div class="file-related-grid">{related.map(item=><a href={url(`/${item.kind}/${item.slug}/`)}><span class="eyebrow">{item.kind}</span><strong>{item.title}</strong><span aria-hidden="true">↗</span></a>)}</div></section>}
  {scientific.length>0&&<section class="file-information" aria-labelledby="file-scientific-heading"><h2 id="file-scientific-heading">Scientific metadata</h2><dl class="file-metadata">{scientific.map(([label,input])=><><dt>{label}</dt><dd>{value(input)}</dd></>)}</dl></section>}
  {file.citation&&<section class="file-information" aria-labelledby="file-citation-heading"><h2 id="file-citation-heading">Citation</h2><pre class="file-citation">{file.citation}</pre><button type="button" class="button-secondary" data-file-copy-text={file.citation}>Copy citation</button></section>}
  {file.versions?.length>0&&<details class="file-history"><summary>Version history</summary><p>Previous file versions are recorded in the metadata history.</p><ul>{file.versions.map((version:any)=><li>{version.originalName||version.name||file.originalName} {version.size!==undefined&&`· ${formatFileSize(version.size)}`} {(version.replacedAt||version.updatedAt)&&`· ${formatDate(version.replacedAt||version.updatedAt)}`}</li>)}</ul></details>}
  {file.visibility==='public'&&<KnowledgeConnections id={`file:${file.id}`}/>}
 </div>
</BaseLayout>
<script>import '../../file-preview/preview.js';import '../../file-preview/library.js';</script>
<style>
 .file-detail{padding-top:2.5rem;padding-bottom:4rem}.breadcrumb{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.75rem;color:var(--muted);margin-bottom:2rem;overflow-wrap:anywhere}.file-detail-header{max-width:900px}.file-detail h1{overflow-wrap:anywhere;font-size:clamp(2.2rem,4vw,3.6rem);line-height:1.18;letter-spacing:-.04em;margin:.7rem 0 1rem}.file-detail-summary{display:flex;flex-wrap:wrap;gap:.45rem 1.3rem;font-size:.8rem;color:var(--muted)}.file-description{font-size:.95rem;margin:1.3rem 0;overflow-wrap:anywhere}.file-description :global(>:last-child){margin-bottom:0}.file-detail-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.5rem 0}.file-detail-actions button{font:inherit;cursor:pointer}.file-detail [data-file-status]{font-size:.85rem;color:var(--muted);overflow-wrap:anywhere}.file-preview{max-width:100%;overflow:auto;background:var(--surface);border-radius:12px}.file-preview:empty{display:none}.file-preview:fullscreen{background:var(--surface);padding:1rem;width:100%;height:100%;overflow:auto}.file-preview :global(iframe){width:100%;height:min(80vh,950px);border:1px solid var(--line)}.file-preview :global(img){max-width:100%;height:auto}.file-preview :global(audio),.file-preview :global(video){width:100%;max-height:75vh}.file-preview :global(pre){white-space:pre-wrap;overflow-wrap:anywhere}.file-preview :global(.file-image-tools){display:flex;gap:1rem;align-items:center;padding:.7rem}.file-preview :global(.file-image-canvas){overflow:auto;max-height:75vh}.file-preview :global(.file-image-canvas img){transform-origin:top left;max-width:100%}.file-information,.file-related-section{margin-top:2.5rem;padding-top:1.3rem;border-top:1px solid var(--line)}.file-information h2,.file-related-section h2{font-size:1.5rem;letter-spacing:-.02em}.file-metadata{display:grid;grid-template-columns:150px minmax(0,1fr);gap:.65rem 1.2rem;margin:1.4rem 0;font-size:.85rem}.file-metadata dt{color:var(--muted)}.file-metadata dd{margin:0;overflow-wrap:anywhere}.file-metadata dd>a{color:var(--accent)}.file-metadata small{font-size:.72rem;color:var(--muted);margin-left:.4rem}.file-metadata code{font-size:.73rem}.file-detail-tags{display:flex;flex-wrap:wrap;gap:.3rem}.file-detail-tags a{border:1px solid var(--line);border-radius:4px;padding:.05rem .45rem;font-size:.75rem}.file-related-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:.8rem}.file-related-grid a{display:grid;grid-template-columns:1fr auto;gap:.7rem;padding:1.1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.file-related-grid .eyebrow{grid-column:1/-1}.file-related-grid strong{font-size:.95rem;font-weight:500;overflow-wrap:anywhere}.file-related-grid a>span:last-child{color:var(--accent)}.file-citation{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:1rem;white-space:pre-wrap;overflow-wrap:anywhere;font: .8rem/1.7 var(--font-mono)}.file-history{font-size:.8rem;color:var(--muted);margin-top:2rem}.file-history summary{cursor:pointer;color:var(--accent)}@media(max-width:500px){.file-metadata{grid-template-columns:100px minmax(0,1fr);gap:.7rem .75rem}.file-detail-actions{font-size:.82rem}.file-metadata small{display:block;margin-left:0}.file-detail{padding-top:1.5rem}}
</style>
