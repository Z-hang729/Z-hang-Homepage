---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FileResources from '../../components/FileResources.astro';
import {getFiles} from '../../lib/file-records';
import {fileGroup,formatFileSize} from '../../lib/files.mjs';
import {FILE_GROUP_LABELS,FILE_CATEGORY_LABELS,fileFolder,compareFiles} from '../../file-preview/library-model.mjs';
const allFiles=getFiles().sort((a,b)=>compareFiles(a,b)),files=allFiles.filter(file=>!file.isFolderBundle&&!file.isDerivative&&!file.derivativeOf),tags=[...new Set(files.flatMap(file=>file.tags))].sort((a,b)=>a.localeCompare(b));
const folders=[...new Set(files.flatMap(file=>{const parts=fileFolder(file).split('/').filter(Boolean);return parts.map((_,index)=>parts.slice(0,index+1).join('/'));}))].sort((a,b)=>a.localeCompare(b));
const stats=[['Files',files.length],['Documents',files.filter(file=>['documents','pdf','notes'].includes(fileGroup(file))).length],['Scientific data',files.filter(file=>fileGroup(file)==='data').length],['Code & notebooks',files.filter(file=>['code','notebooks'].includes(fileGroup(file))).length],['Logical size',formatFileSize(files.reduce((total,file)=>total+file.size,0))]];
---
<BaseLayout title="Z-hang’s Library" description="Research files, course materials, code and scientific data. Browse previews and download the original files.">
 <div class="container section library-page" data-file-library data-library-view="grid">
  <header class="library-header"><p class="eyebrow">THE ACADEMIC FILE LIBRARY</p><h1>Z-hang’s Library</h1><p class="section-description">Research files, course materials, code and data — with their context, previews and original downloads.</p></header>
  <dl class="library-stats" aria-label="Library statistics">{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
  <div class="library-controls" data-pagefind-ignore>
   <label class="file-search"><span>Search files</span><input type="search" data-file-search placeholder="Filename, course, research, tag or folder…" autocomplete="off" aria-controls="file-resources"/></label>
   <div class="library-filters">
    <label><span>File type</span><select data-library-filter="group" aria-controls="file-resources"><option value="">All file types</option>{Object.entries(FILE_GROUP_LABELS).map(([value,label])=><option value={value}>{label}</option>)}</select></label>
    <label><span>Collection</span><select data-library-filter="category" aria-controls="file-resources"><option value="">All collections</option>{Object.entries(FILE_CATEGORY_LABELS).map(([value,label])=><option value={value}>{label}</option>)}</select></label>
    <label><span>Folder</span><select data-library-filter="folder" aria-controls="file-resources"><option value="">All folders</option>{folders.map(folder=><option value={folder}>{folder}</option>)}</select></label>
    <label><span>Tag</span><select data-library-filter="tag" aria-controls="file-resources"><option value="">All tags</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>
    <label><span>Updated</span><select data-library-filter="days" aria-controls="file-resources"><option value="">Any time</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="365">Last year</option></select></label>
   </div>
   <div class="library-view-row"><div class="library-views" role="group" aria-label="Library view"><button type="button" data-library-view-button="grid" aria-pressed="true" aria-controls="file-resources">Grid</button><button type="button" data-library-view-button="list" aria-pressed="false" aria-controls="file-resources">List</button><button type="button" data-library-view-button="folders" aria-pressed="false" aria-controls="file-resources">Folders</button></div><label class="library-sort"><span>Sort</span><select data-library-sort aria-controls="file-resources"><option value="updated">Recently updated</option><option value="added">Recently added</option><option value="name">Name A–Z</option><option value="size">Largest first</option></select></label><button type="button" class="library-reset" data-library-reset>Clear filters</button></div>
  </div>
  <FileResources files={allFiles} title="Browse files" library/>
  {!files.length&&<p class="library-publish-empty">Published files will appear here. Owner controls are available after signing in.</p>}
  <p class="library-footnote">File pages keep a stable address. Downloads preserve the original file; previews load only when opened.</p>
 </div>
</BaseLayout>
<style>
 .library-page{padding-top:3.2rem;padding-bottom:4rem}.library-header h1{font-size:clamp(2.8rem,5vw,4.3rem);letter-spacing:-.055em;line-height:1.1;margin:.7rem 0 1rem}.library-header h1 span{color:var(--solar)}.library-header .section-description{max-width:660px;font-size:1rem;line-height:1.7;color:var(--muted)}.library-stats{display:flex;flex-wrap:wrap;gap:1.5rem 3rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:1.2rem 0;margin:2rem 0}.library-stats div{display:flex;flex-direction:column-reverse;gap:.2rem}.library-stats dt{font-size:.7rem;color:var(--muted)}.library-stats dd{font:500 1.2rem var(--font-mono);margin:0}.library-controls{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.2rem}.file-search{display:flex;flex-direction:column;gap:.45rem}.library-controls label>span{font-size:.7rem;color:var(--muted)}.library-controls input,.library-controls select{padding:.65rem .75rem;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--ink);font:inherit;min-width:0;width:100%}.file-search input{font-size:.95rem}.library-filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem;margin:1rem 0}.library-filters label{display:flex;flex-direction:column;gap:.35rem;min-width:0}.library-filters select{font-size:.78rem}.library-view-row{display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;border-top:1px solid var(--line);padding-top:1rem}.library-views{display:flex;gap:.2rem;background:var(--bg);border:1px solid var(--line);border-radius:7px;padding:3px}.library-views button{font-size:.76rem;padding:.4rem .8rem;border:0;border-radius:5px;background:transparent;color:var(--muted)}.library-views button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent);font-weight:600}.library-sort{display:flex;align-items:center;gap:.5rem;margin-left:auto}.library-sort select{font-size:.76rem;min-width:160px;padding:.45rem .65rem}.library-reset{border:0;background:none;padding:.45rem 0;font-size:.72rem;color:var(--accent);text-decoration:underline;text-underline-offset:3px}.library-footnote,.library-publish-empty{font-size:.75rem;color:var(--muted);margin-top:2rem;max-width:760px}@media(max-width:900px){.library-filters{grid-template-columns:repeat(3,minmax(0,1fr))}.library-stats{gap:1rem 2rem}}@media(max-width:600px){.library-page{padding-top:2rem}.library-header h1{font-size:2.7rem}.library-header .section-description{font-size:.9rem}.library-stats{gap:1rem 1.5rem;margin:1.5rem 0}.library-stats dd{font-size:1rem}.library-controls{padding:.9rem}.library-filters{grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.library-sort{margin-left:0;flex:1}.library-sort select{min-width:0}.library-sort>span{display:none}.library-reset{width:100%;text-align:left;padding:0}.library-views button{padding:.4rem .65rem}}
</style>
