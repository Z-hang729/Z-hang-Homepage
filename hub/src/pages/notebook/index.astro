---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, url } from '../../lib/site';
import { sortLatest } from '../../lib/content';

const notes = sortLatest(await getCollection('notes'));
const courses = [...new Set(notes.map((note) => note.data.course).filter(Boolean))];
const semesters = [...new Set(notes.map((note) => note.data.semester).filter(Boolean))];
---

<BaseLayout title="Research notebook" description="A read-only index of course notes, methods, and connected research questions.">
  <div class="container notebook-page">
    <header class="page-intro">
      <p class="eyebrow">READING ROOM</p>
      <h1>Research notebook.</h1>
      <p class="intro-description">A calm, static reader for course notes and working ideas. Pages are rendered from the published archive; this view never executes notebook code.</p>
      <nav class="notebook-links" aria-label="Notebook navigation">
        <a class="button" href={url('/notes/')}>Browse all notes →</a>
        <a class="button-secondary" href={url('/workflow/')}>See the research workflow</a>
      </nav>
    </header>

    <section class="notebook-summary" aria-label="Notebook summary">
      <div><strong>{notes.length}</strong><span>published notes</span></div>
      <div><strong>{courses.length}</strong><span>courses</span></div>
      <div><strong>{semesters.length}</strong><span>semesters</span></div>
    </section>

    {notes.length ? <section aria-labelledby="notebook-index-heading">
      <div class="notebook-heading"><div><p class="eyebrow">STATIC READER</p><h2 id="notebook-index-heading">Open a notebook.</h2></div><p class="muted">Updated entries appear first.</p></div>
      <div class="notebook-list">
        {notes.map((note) => <a class="notebook-entry" href={url(`/notes/${note.id}/`)}>
          <div class="notebook-entry-meta"><span>{note.data.category}</span><time datetime={new Date(note.data.updated).toISOString()}>{formatDate(note.data.updated)}</time></div>
          <h3>{note.data.title}</h3>
          <p>{note.data.description}</p>
          <div class="notebook-entry-footer"><span>{note.data.course} · {note.data.semester}</span>{note.data.progress > 0 && <span>Archive progress {note.data.progress}%</span>}<span aria-hidden="true">↗</span></div>
        </a>)}
      </div>
    </section> : <section class="empty-state" aria-labelledby="notebook-empty-heading"><p class="eyebrow">READING ROOM</p><h2 id="notebook-empty-heading">No published notes yet.</h2><p>When a note is ready to share, it will appear here without changing the original source file.</p></section>}
  </div>
</BaseLayout>

<style>
  .notebook-page{padding-bottom:6rem}.notebook-links{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.7rem}.notebook-summary{display:flex;flex-wrap:wrap;gap:1.5rem 3rem;padding:1.2rem 0;margin-bottom:3.2rem;border-block:1px solid var(--line)}.notebook-summary div{display:flex;flex-direction:column;gap:.2rem}.notebook-summary strong{font:700 1.35rem var(--font-mono);color:var(--accent)}.notebook-summary span{font-size:.72rem;color:var(--muted)}.notebook-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}.notebook-heading h2{font:2rem var(--font-serif);margin:.5rem 0 0}.notebook-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.notebook-entry{display:flex;flex-direction:column;gap:.55rem;padding:1.3rem;border:1px solid var(--line);background:var(--surface);border-radius:8px;min-height:210px}.notebook-entry:hover{border-color:var(--accent);transform:translateY(-1px)}.notebook-entry-meta,.notebook-entry-footer{display:flex;flex-wrap:wrap;gap:.5rem 1rem;color:var(--muted);font:10px var(--font-mono)}.notebook-entry-meta{justify-content:space-between}.notebook-entry h3{font:1.5rem/1.3 var(--font-serif);margin:.3rem 0 0}.notebook-entry p{font-size:.9rem;line-height:1.65;color:var(--muted);margin:0}.notebook-entry-footer{margin-top:auto;padding-top:.85rem;border-top:1px solid var(--line);color:var(--accent)}.notebook-entry-footer span:last-child{margin-left:auto}@media(max-width:650px){.notebook-heading{display:block}.notebook-heading>.muted{margin-top:.5rem}.notebook-list{grid-template-columns:1fr}.notebook-entry{min-height:0}.notebook-summary{gap:1rem 2rem}}
</style>
