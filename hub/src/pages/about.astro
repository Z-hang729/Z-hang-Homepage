---
import BaseLayout from '../layouts/BaseLayout.astro';
import {profile,url} from '../lib/site';
---
<BaseLayout title="About"><div class="container"><header class="page-intro"><p class="eyebrow">THE PERSON BEHIND THE NOTEBOOK</p><h1>A little about me.</h1><p class="intro-description">{profile.role} · {profile.university}</p></header><div class="profile-page"><aside class="profile-aside">{profile.avatar?<img class="monogram" src={url(profile.avatar)} alt={profile.displayName}/>:<div class="monogram" aria-hidden="true">Z</div>}<div><p>{profile.affiliation}</p><p>{profile.degree}<br/>{profile.secondDegree}</p><a class="text-link" href={url('/cv/')}>View curriculum vitae →</a></div></aside><article class="profile-body"><section><p class="eyebrow">BIOGRAPHY</p><h2>{profile.displayName}</h2><p>{profile.bio}</p><p lang="zh-CN" class="muted">{profile.bioZh}</p></section><section><p class="eyebrow">EDUCATION</p><h2>Learning across disciplines.</h2>{profile.education.map((item:any)=><div class="education-item"><div><h3>{item.institution}</h3><p>{item.description}</p></div><time>{item.start} — {item.end}</time></div>)}</section><section><p class="eyebrow">RESEARCH INTERESTS</p><h2>Questions I gravitate toward.</h2><div class="interests">{profile.researchInterests.map((interest:string)=><span class="interest">{interest}</span>)}</div></section>{profile.skills.length>0&&<section><h2>Skills &amp; languages</h2><div class="interests">{profile.skills.map((skill:string)=><span class="interest">{skill}</span>)}</div></section>}{profile.tools.length>0&&<section><h2>Research tools</h2><div class="interests">{profile.tools.map((tool:string)=><span class="interest">{tool}</span>)}</div></section>}{profile.futureInterests.length>0&&<section><h2>Looking ahead</h2><ul>{profile.futureInterests.map((interest:string)=><li>{interest}</li>)}</ul></section>}</article></div></div></BaseLayout>
