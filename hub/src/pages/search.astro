---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Search"><div class="container search-page"><header class="page-intro"><p class="eyebrow">ACROSS THE GARDEN</p><h1>Follow a thought.</h1><p class="intro-description">Find research, course notes, projects, or an idea that connects them.</p></header><button class="button" data-search-open><Icon name="search" size={17}/>Search the archive</button><p class="muted" style="font-size:12px;margin-top:20px">You can also press Ctrl K or ⌘ K from any page.</p></div></BaseLayout>
