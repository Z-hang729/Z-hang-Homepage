---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {profile,url} from '../lib/site';
---
<BaseLayout title="Curriculum vitae"><div class="container"><header class="page-intro"><p class="eyebrow">CURRICULUM VITAE</p><h1>{profile.displayName}</h1><p class="intro-description">{profile.degree} × {profile.secondDegree}<br/>{profile.role}, {profile.university}</p><div class="cv-toolbar">{profile.cvPdf&&<a class="button" href={url(profile.cvPdf)} download><Icon name="download" size={16}/>Download CV PDF</a>}<button class="button-secondary" id="print-cv">Print / Save as PDF</button></div></header><article class="profile-body" style="max-width:850px;padding:25px 0 60px"><section><h2>Profile</h2><p>{profile.bio}</p></section><section><h2>Education</h2>{profile.education.map((item:any)=><div class="education-item"><div><h3>{item.institution}</h3><p>{item.description}</p></div><time>{item.start} — {item.end}</time></div>)}</section><section><h2>Research interests</h2><div class="interests">{profile.researchInterests.map((item:string)=><span class="interest">{item}</span>)}</div></section>{profile.skills.length>0&&<section><h2>Skills</h2><p>{profile.skills.join(' · ')}</p></section>}{['honors','presentations'].map(key=>profile[key].length>0&&<section><h2>{key==='honors'?'Honors & awards':'Presentations'}</h2><ul>{profile[key].map((item:any)=><li>{typeof item==='string'?item:item.title}</li>)}</ul></section>)}<section><h2>Publications</h2><a class="text-link" href={url('/publications/')}>View the publication archive →</a></section>{profile.email&&<section><h2>Contact</h2><a href={`mailto:${profile.email}`}>{profile.email}</a></section>}</article></div><script>document.querySelector('#print-cv')?.addEventListener('click',()=>window.print());</script></BaseLayout>
