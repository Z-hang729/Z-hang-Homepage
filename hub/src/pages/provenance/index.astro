---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url, formatDate } from '../../lib/site';
import { getFiles } from '../../lib/file-records';
import { readAcademicRecords } from '../../lib/academic-records.mjs';
import { buildProvenanceBoard } from '../../lib/provenance-board.mjs';

const researchEntries = await getCollection('research');
const figures = readAcademicRecords('figures', { publicOnly: true });
const board = buildProvenanceBoard({ researchEntries: researchEntries as any, figures: figures as any, files: getFiles() as any });
const statusLabel: Record<string, string> = { complete: 'Complete', partial: 'Partial', missing: 'Needs context' };
const cardPath = (card: any) => card.kind === 'figure' ? url(`/figures/${card.id.replace(/^figure:/, '')}/`) : card.repository;
---
<BaseLayout title="Research provenance" description="Code and figure provenance derived from research and File Library records.">
  <main class="container catalog-page provenance-page" data-provenance-board>
    <header class="page-intro catalog-header"><p class="eyebrow">RESEARCH PROVENANCE</p><h1>Show the path behind the result.</h1><p class="intro-description">Code links and scientific figures are grouped by their research context, experiment references and original files. The board is a read-only view of records you have already supplied.</p><nav class="catalog-nav" aria-label="Research catalog navigation"><a href={url('/research/')}>Research</a><a href={url('/experiments/')}>Experiments</a><a href={url('/datasets/')}>Datasets</a><a href={url('/figures/')}>Figures</a><a href={url('/files/')}>File Library</a></nav></header>
    <dl class="catalog-stats" aria-label="Provenance statistics"><div><dt>Sources</dt><dd>{board.cards.length}</dd></div><div><dt>Code records</dt><dd>{board.code.length}</dd></div><div><dt>Figure records</dt><dd>{board.figures.length}</dd></div><div><dt>Complete context</dt><dd>{board.cards.filter(card => card.provenance === 'complete').length}</dd></div><div><dt>Links</dt><dd>{board.edges.length}</dd></div></dl>
    {board.cards.length ? <>
      <div class="catalog-controls" data-pagefind-ignore><label><span>Search provenance</span><input type="search" data-provenance-query placeholder="Title, repository, commit or research…" /></label><label><span>Record type</span><select data-provenance-kind><option value="">Code and figures</option><option value="code">Code</option><option value="figure">Figures</option></select></label><label><span>Context status</span><select data-provenance-status><option value="">All statuses</option><option value="complete">Complete</option><option value="partial">Partial</option><option value="missing">Needs context</option></select></label></div>
      <div class="catalog-list" data-provenance-list>{board.cards.map(card => <article class="catalog-card provenance-card" data-provenance-card data-kind={card.kind} data-status={card.provenance} data-search={[card.title, card.repository, card.commit, card.language, card.caption, ...(card.usedBy || []), ...(card.relatedResearch || []), ...(card.experiments || []), ...(card.relatedExperiments || [])].join(' ').toLocaleLowerCase()}>
        <div class="catalog-card-heading"><div><p class="eyebrow">{card.kind === 'figure' ? 'SCIENTIFIC FIGURE' : 'CODE ARCHIVE'} · {card.provenance}</p><h2>{card.title}</h2></div><span class={`provenance-badge provenance-${card.provenance}`}>{statusLabel[card.provenance]}</span></div>
        {card.kind === 'code' ? <dl class="catalog-meta">{card.language && <><dt>Language</dt><dd>{card.language}</dd></>}{card.repository && <><dt>Repository</dt><dd><a href={card.repository} rel="noopener noreferrer">{card.repository}</a></dd></>}{card.commit && <><dt>Commit</dt><dd><code>{card.commit}</code></dd></>}{card.readme && <><dt>README</dt><dd><a href={card.readme} rel="noopener noreferrer">Open README ↗</a></dd></>}</dl> : <><p>{card.caption || 'Caption not recorded yet.'}</p><dl class="catalog-meta"><dt>Original</dt><dd>{card.fileId ? <a href={url(`/files/${card.fileId.replace(/^file:/, '')}/`)}>{card.fileId}</a> : 'No File Library original linked'}</dd>{card.date && <><dt>Date</dt><dd>{formatDate(card.date)}</dd></>}{card.altText && <><dt>Alt text</dt><dd>{card.altText}</dd></>}</dl></>}
        <div class="catalog-links">{(card.usedBy || card.relatedResearch || []).map((id: string) => <a href={url(`/research/${id.replace(/^research:/, '')}/`)}>{id}</a>)}{(card.experiments || card.relatedExperiments || []).map((id: string) => <span>{id}</span>)}{card.kind === 'figure' && <a href={cardPath(card)}>Open record →</a>}{card.kind === 'code' && card.repository && <a href={cardPath(card)} rel="noopener noreferrer">Repository ↗</a>}</div>
      </article>)}</div>
      <p class="catalog-empty" data-provenance-empty hidden>No provenance record matches those filters.</p>
    </> : <section class="catalog-empty"><h2>No provenance records yet.</h2><p>Code archives and scientific figures will appear here once you create real records in Owner. The board never copies source code or creates a figure without an existing File Library original.</p><a class="button-secondary" href={url('/owner/')}>Open Owner workspace →</a></section>}
  </main>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-provenance-board]');
  const query = root?.querySelector<HTMLInputElement>('[data-provenance-query]');
  const kind = root?.querySelector<HTMLSelectElement>('[data-provenance-kind]');
  const status = root?.querySelector<HTMLSelectElement>('[data-provenance-status]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-provenance-card]') || [])];
  const empty = root?.querySelector<HTMLElement>('[data-provenance-empty]');
  function apply() { const term = (query?.value || '').trim().toLocaleLowerCase(); let shown = 0; for (const card of cards) { const ok = (!term || (card.dataset.search || '').includes(term)) && (!kind?.value || card.dataset.kind === kind.value) && (!status?.value || card.dataset.status === status.value); card.hidden = !ok; if (ok) shown++; } if (empty) empty.hidden = shown !== 0; }
  query?.addEventListener('input', apply); kind?.addEventListener('change', apply); status?.addEventListener('change', apply);
</script>
<style>
  .catalog-page{padding:3.2rem 0 5rem}.catalog-header h1{font-size:clamp(2.7rem,6vw,4.6rem);letter-spacing:-.06em;margin:.7rem 0 1rem}.catalog-header .intro-description{max-width:740px}.catalog-nav{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:1.5rem;font-size:.78rem}.catalog-nav a{color:var(--accent)}.catalog-stats{display:flex;flex-wrap:wrap;gap:1.3rem 3rem;border-block:1px solid var(--line);padding:1.15rem 0;margin:2.3rem 0}.catalog-stats div{display:grid;gap:.25rem}.catalog-stats dt{font-size:.7rem;color:var(--muted)}.catalog-stats dd{font:500 1.2rem var(--font-mono);margin:0}.catalog-controls{display:grid;grid-template-columns:minmax(220px,1fr) 180px 180px;gap:.75rem;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1rem;margin-bottom:1.4rem}.catalog-controls label{display:grid;gap:.35rem}.catalog-controls span{font-size:.72rem;color:var(--muted)}.catalog-controls input,.catalog-controls select{width:100%;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:.62rem .7rem;color:var(--ink);font:inherit}.catalog-list{display:grid;gap:1rem}.catalog-card{border:1px solid var(--line);border-radius:10px;padding:1.25rem;background:var(--surface)}.catalog-card[hidden],.catalog-empty[hidden]{display:none}.catalog-card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.catalog-card h2{font-size:1.35rem;margin:.35rem 0 .8rem}.provenance-badge{font-size:.68rem;border:1px solid var(--line);border-radius:999px;padding:.25rem .55rem;white-space:nowrap}.provenance-complete{color:var(--accent)}.provenance-partial{color:var(--solar)}.provenance-missing{color:var(--muted)}.catalog-meta{display:grid;grid-template-columns:130px minmax(0,1fr);gap:.45rem .8rem;margin:1rem 0;font-size:.82rem}.catalog-meta dt{color:var(--muted)}.catalog-meta dd{margin:0;overflow-wrap:anywhere}.catalog-meta code{font-size:.72rem;overflow-wrap:anywhere}.catalog-links{display:flex;flex-wrap:wrap;gap:.45rem .8rem;border-top:1px solid var(--line);padding-top:.75rem;font: .72rem var(--font-mono);overflow-wrap:anywhere}.catalog-links a{color:var(--accent)}.catalog-empty{border:1px dashed var(--line);padding:2rem;border-radius:10px;color:var(--muted)}.catalog-empty h2{color:var(--ink);margin-top:0}@media(max-width:760px){.catalog-controls{grid-template-columns:1fr 1fr}.catalog-controls label:first-child{grid-column:1/-1}}@media(max-width:520px){.catalog-page{padding-top:2rem}.catalog-controls{grid-template-columns:1fr}.catalog-card-heading{display:block}.provenance-badge{display:inline-block}.catalog-meta{grid-template-columns:100px minmax(0,1fr)}}
</style>
