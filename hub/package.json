{
  "name": "zhang-academic-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "admin": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && astro build --force && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "import:research": "node scripts/import-folder.mjs research",
    "import:notes": "node scripts/import-folder.mjs notes",
    "import:project": "node scripts/import-folder.mjs projects",
    "publish": "node scripts/publish.mjs",
    "test:browser": "node scripts/browser-qa.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "astro": "^7.3.5",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "pagefind": "^1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
